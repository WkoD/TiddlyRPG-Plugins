modified: 20261002082222000
tags: $:/tags/ViewTemplate
title: $:/plugins/dndwiki-core/viewtemplates/event
type: text/vnd.tiddlywiki

<!-- Head of an event, the same content as its card in the timeline: after title, modified date
     and tags (core) the span of the date field (one section as it is, several from the first
     start to the last end), the locations linked before the first <<date>> (for an event
     without placeholders: the whole body) and a rule before the body. -->
<$reveal tag="div" class="tc-tiddler-body" type="nomatch" stateTitle=<<folded-state>> text="hide" retain="yes" animate="yes">
<%if [<currentTiddler>dnd.visible[]] %>
<$list filter="[all[current]tag[Event]]">
<div class="dnd-event-head">
<$let dnd-text={{{ [<currentTiddler>get[date]dateformat:era[]] }}}>
<%if [<dnd-text>!is[blank]] %><div class="dnd-event-span"><$text text=<<dnd-text>>/></div><%endif%>
</$let>
<<dnd.datecheck>>
<$transclude $variable="dnd.places" section="0"/>
</div>
<hr class="dnd-event-rule"/>
</$list>
<%endif%>
</$reveal>

<!-- Head of an event below its tags: the locations linked before the first <<date>> (for an
     event without placeholders: the whole body), a hint on a date that cannot be read, and a
     rule before the body. The span of the date field stands above the title
     (templates/title-event). -->
<$reveal tag="div" class="tc-tiddler-body" type="nomatch" stateTitle=<<folded-state>> text="hide" retain="yes" animate="yes">
<%if [<currentTiddler>dnd.visible[]] %>
<$list filter="[all[current]tag[Event]]">
<div class="dnd-event-head">
<<dnd.datecheck>>
<$transclude $variable="dnd.places" section="0"/>
</div>
<hr class="dnd-event-rule"/>
</$list>
<%endif%>
</$reveal>

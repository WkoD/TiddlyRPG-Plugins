<!-- Head of an event below its tags: the span of its date field as the date line (right, grey;
     the same procedure as the years of existence of the other types, viewtemplates/activity),
     the locations linked before the first <<date>> and a rule before the body. -->
<$reveal tag="div" class="tc-tiddler-body" type="nomatch" stateTitle=<<folded-state>> text="hide" retain="yes" animate="yes">
<%if [<currentTiddler>dnd.visible[]] %>
<$list filter="[all[current]tag[Event]]">
<div class="dnd-event-head">
<<dnd.dateline>>
<$transclude $variable="dnd.places" section="0"/>
</div>
<hr class="dnd-event-rule"/>
</$list>
<%endif%>
</$reveal>

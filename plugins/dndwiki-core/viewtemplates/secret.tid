<!-- Marker of a locked tiddler (tag Secret) below the tags, for everyone who sees it (the DM
     and the players it is for): who it is for, or "DM only". -->
<$reveal tag="div" class="tc-tiddler-body" type="nomatch" stateTitle=<<folded-state>> text="hide" retain="yes" animate="yes">
<%if [<currentTiddler>tag[Secret]] :filter[dnd.visible[]] %>
<$let dnd-for={{{ [<currentTiddler>dndcharacters[]] +[join[, ]] }}}>
<div class="dnd-secret-marker">{{$:/core/images/locked-padlock}}<$text text={{{ [<dnd-for>!is[blank]] :then[[Secret/For]dndtranslate[]search-replace[$names$],<dnd-for>] ~[[Secret/DMOnly]dndtranslate[]] }}}/></div>
</$let>
<%endif%>
</$reveal>

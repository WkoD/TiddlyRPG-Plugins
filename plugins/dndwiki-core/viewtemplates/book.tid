<!-- The file of a book below the body: field data, a file name in data/book/ (like image in
     images/<folder>/), embedded by the browser (PDF). Not for tiddlers locked for the player. -->
<%if [<currentTiddler>tag[Book]has[data]] :filter[dnd.visible[]] %>
<$reveal tag="div" class="tc-tiddler-body dnd-book-data" type="nomatch" stateTitle=<<folded-state>> text="hide" retain="yes" animate="yes">
<embed width="100%" height="850" src={{{ [<currentTiddler>get[data]trim[]encodeuricomponent[]addprefix[data/book/]] }}}/>
</$reveal>
<%endif%>

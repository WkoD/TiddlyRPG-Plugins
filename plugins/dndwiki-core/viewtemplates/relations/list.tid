caption: <<dnd.t Relations/List>>
created: 20260713135021000
modified: 20261006064449000
title: $:/plugins/dndwiki-core/viewtemplates/relations/list
type: text/vnd.tiddlywiki

\function dnd.hits.default() [<self>listed<field>!is[system]] =[<self>get<field>enlist-input[]] +[!match<self>unique[]sort[title]]
\function dnd.here(place) [<place>occupants[]] :filter[get[location]enlist-input[]match<place>] +[!match<self>sort[title]]
\function dnd.hits.leader() [<self>listed[leader]!is[system]] =[<self>get[leader]enlist-input[]!tag[Location]] +[!match<self>unique[]sort[title]]

\procedure dnd.group(label)
<%if [(hits)] %>
<h3 class="dnd-relations-group"><$text text=<<label>>/></h3>
<$list filter="[(hits)]">
<div class="tc-menu-list-subitem"><<deadlink title={{!!title}} style="~~">></div>
</$list>
<%endif%>
\end

\procedure dnd.tree.entry(place,sub)
\whitespace trim
<<deadlink title=<<sub>> style="~~">><%if [<sub>spotowner[]match<place>] %><span class="dnd-via"><$text text={{{ [[Relations/Spot]dndtranslate[]addprefix[ (]addsuffix[)]] }}}/></span><%endif%>
\end

\procedure dnd.tree(place,depth)
\whitespace trim
<$list filter="[dnd.here<place>]">
<div class="tc-menu-list-subitem"><<deadlink title={{!!title}} style="~~">></div>
</$list>
<%if [<depth>compare:number:lt[10]] %>
<$list filter="[<place>sublocations[]] +[sort[title]]" variable="dnd-sub">
<$let dnd-n={{{ [dnd.here<dnd-sub>] [<dnd-sub>sublocations[]] +[count[]] }}}
	dnd-next={{{ [<depth>add[1]] }}}>
<%if [<dnd-n>match[0]] %>
<div class="tc-menu-list-subitem"><$transclude $variable="dnd.tree.entry" place=<<place>> sub=<<dnd-sub>>/></div>
<%else%>
<details class="dnd-tree"><summary class="tc-menu-list-subitem"><$transclude $variable="dnd.tree.entry" place=<<place>> sub=<<dnd-sub>>/></summary><div class="dnd-tree-children"><$transclude $variable="dnd.tree" place=<<dnd-sub>> depth=<<dnd-next>>/></div></details>
<%endif%>
</$let>
</$list>
<%endif%>
\end

<!-- Iterates over all field edge types and shows ONE group per relation (forward: own fields
     UNION backward: who points here) under the label Field/<field> from the language packs -
     the same label the graph templates put on the edges. `self` comes from the calling
     relations.tid. Backward via the indexed operator `listed` instead of a search over all
     tiddlers; the hits are held once in the multi-valued variable `hits` and used for heading
     and list.
     Locations (filters/location.js): on a location the group "location" is a tree (procedure
     dnd.tree) instead of the locations above and below it: who is there, then each place within
     (both kinds, a spot marked) with who is there and its own places within, every depth.
     Every place with entries starts folded (<details>). The parent is in the path
     below the title. Leading a location (leader -> location) is the group "Controls", not
     "Leader". -->

<$list filter="[all[shadows+tiddlers]prefix[$:/config/flibbles/graph/edges/fields/]removeprefix[$:/config/flibbles/graph/edges/fields/]] -[[tags]] -[[list]] +[sort[]]" variable=field>
<$let dnd-label={{{ [<field>addprefix[Field/]dndtranslate[]] }}}>
<%if [<field>match[location]] :filter[<self>tag[Location]] %>
<%if [<self>occupants[]] [<self>sublocations[]] +[first[]] %>
<h3 class="dnd-relations-group"><$text text=<<dnd-label>>/></h3>
<$transclude $variable="dnd.tree" place=<<self>> depth="0"/>
<%endif%>
<%elseif [<field>match[leader]] %>
<$let hits={{{ [dnd.hits.leader[]] }}}><$transclude $variable="dnd.group" label=<<dnd-label>>/></$let>
<%else%>
<$let hits={{{ [dnd.hits.default[]] }}}><$transclude $variable="dnd.group" label=<<dnd-label>>/></$let>
<%endif%>
</$let>
</$list>
<$let hits={{{ [<self>get[leader]enlist-input[]tag[Location]] +[sort[title]] }}}><$transclude $variable="dnd.group" label={{{ [[Relations/Rules]dndtranslate[]] }}}/></$let>


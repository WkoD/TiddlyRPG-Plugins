caption: <<dnd.t Relations/List>>
created: 20260713135021000
modified: 20261001095424000
title: $:/plugins/dndwiki-core/viewtemplates/relations/list
type: text/vnd.tiddlywiki

<!-- Iterates over all field edge types and shows ONE group per relation (forward: own fields
     UNION backward: who points here) under the label Field/<field> from the language packs -
     the same label the graph templates put on the edges. `self` comes from the calling
     relations.tid. Backward via the indexed operator `listed` instead of a search over all
     tiddlers; the hits are held once in the multi-valued variable `hits` and used for heading
     and list. -->

<$list filter="[all[shadows+tiddlers]prefix[$:/config/flibbles/graph/edges/fields/]removeprefix[$:/config/flibbles/graph/edges/fields/]] -[[tags]] -[[list]] +[sort[]]" variable=field>
<$let hits={{{ [<self>listed<field>!is[system]] =[<self>get<field>enlist-input[]] +[!match<self>unique[]sort[title]] }}}>
<%if [(hits)] %>
<h3 style="text-transform:capitalize;"><$text text={{{ [<field>addprefix[Field/]dndtranslate[]] }}}/></h3>
<$list filter="[(hits)]">
<div class="tc-menu-list-subitem"><<deadlink title={{!!title}} style="~~">></div>
</$list>
<%endif%>
</$let>
</$list>

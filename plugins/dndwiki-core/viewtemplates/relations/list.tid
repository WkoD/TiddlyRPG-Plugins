caption: <<dnd.t Relations/List>>
created: 20260713135021000
modified: 20261008062202000
title: $:/plugins/dndwiki-core/viewtemplates/relations/list
type: text/vnd.tiddlywiki

\function dnd.forward(type) [<self>relationtargets<type>!is[system]] :filter[dnd.visible[]] +[!match<self>sort[title]]
\function dnd.backward(type) [<self>relationsources<type>!is[system]] :filter[dnd.visible[]] +[!match<self>sort[title]]
\function dnd.both(type) [dnd.forward<type>] [dnd.backward<type>] +[sort[title]]
\function dnd.at(place) [<currentTiddler>get[location]enlist-input[]] [<currentTiddler>get[leader]enlist-input[]] +[match<place>]
\function dnd.here(place) [<place>occupants[]] :filter[dnd.at<place>] :filter[dnd.visible[]] +[!match<self>sort[title]]
\function dnd.within(place) [<place>sublocations[]] :filter[dnd.visible[]] +[sort[title]]

\procedure dnd.group(label)
<%if [(hits)] %>
<h3 class="dnd-relations-group"><$text text=<<label>>/></h3>
<$list filter="[(hits)]">
<div class="tc-menu-list-subitem"><<deadlink title={{!!title}} style="~~">></div>
</$list>
<%endif%>
\end

\procedure dnd.tree.entry(place,sub)
\whitespace trim
<<deadlink title=<<sub>> style="~~">><%if [<sub>spotowner[]match<place>] %><span class="dnd-via"><$text text={{{ [[Relations/Spot]dndtranslate[]addprefix[ (]addsuffix[)]] }}}/></span><%endif%>
\end

\procedure dnd.tree(place,depth)
\whitespace trim
<$list filter="[dnd.here<place>]">
<div class="tc-menu-list-subitem"><<deadlink title={{!!title}} style="~~">><%if [<currentTiddler>get[leader]enlist-input[]match<place>] %><span class="dnd-via"><$text text={{{ [[Edge/rules]dndtranslate[]addprefix[ (]addsuffix[)]] }}}/></span><%endif%></div>
</$list>
<%if [<depth>compare:number:lt[10]] %>
<$list filter="[dnd.within<place>]" variable="dnd-sub">
<$let dnd-n={{{ [dnd.here<dnd-sub>] [dnd.within<dnd-sub>] +[count[]] }}}
	dnd-next={{{ [<depth>add[1]] }}}>
<%if [<dnd-n>match[0]] %>
<div class="tc-menu-list-subitem"><$transclude $variable="dnd.tree.entry" place=<<place>> sub=<<dnd-sub>>/></div>
<%else%>
<details class="dnd-tree"><summary class="tc-menu-list-subitem"><$transclude $variable="dnd.tree.entry" place=<<place>> sub=<<dnd-sub>>/></summary><div class="dnd-tree-children"><$transclude $variable="dnd.tree" place=<<dnd-sub>> depth=<<dnd-next>>/></div></details>
<%endif%>
</$let>
</$list>
<%endif%>
\end

<!-- The relations of `self` (from the calling relations.tid), type by type in the order of the
     axes (modules/relations.js), with the same rules as the graph: a type another one includes
     is left out (a leader is no member as well). A directed type shows two groups: forward
     (Field/<type>: "Member of") from the own field, and the way back (FieldInverse/<type>:
     "Members") from who points here, via the indexed operator `listed`. A symmetric type shows
     one group, both ways together. The hits are held once in the multi-valued variable `hits`
     and used for heading and list.
     Locations (filters/location.js): on a location the way back of "location" is a tree
     (procedure dnd.tree) instead of the locations above and below it: who is there - who leads
     it marked -, then each place within (both kinds, a spot marked) with who is there and its
     own places within, every depth. Every place with entries starts folded (<details>). The
     parent is in the path below the title, the places a tiddler leads in the group of the
     function type rules ("Controls"). -->

<$list filter="[relationtypes:list[]]" variable=type>
<$let dnd-label={{{ [<type>addprefix[Field/]dndtranslate[]] }}}
	dnd-inverse={{{ [<type>addprefix[FieldInverse/]dndtranslate[]] :filter[!prefix[FieldInverse/]] ~[<type>addprefix[Field/]dndtranslate[]] }}}>
<%if [<type>match[location]] :filter[<self>tag[Location]] %>
<%if [<self>occupants[]] [<self>sublocations[]] :filter[dnd.visible[]] +[first[]] %>
<h3 class="dnd-relations-group"><$text text=<<dnd-inverse>>/></h3>
<$transclude $variable="dnd.tree" place=<<self>> depth="0"/>
<%endif%>
<%elseif [<type>relationsymmetric[]] %>
<$let hits={{{ [dnd.both<type>] }}}><$transclude $variable="dnd.group" label=<<dnd-label>>/></$let>
<%else%>
<$let hits={{{ [dnd.forward<type>] }}}><$transclude $variable="dnd.group" label=<<dnd-label>>/></$let>
<%if [<type>!match[rules]] %>
<$let hits={{{ [dnd.backward<type>] }}}><$transclude $variable="dnd.group" label=<<dnd-inverse>>/></$let>
<%endif%>
<%endif%>
</$let>
</$list>

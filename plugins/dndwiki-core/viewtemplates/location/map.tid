title: $:/plugins/dndwiki-core/viewtemplates/location/map
type: text/vnd.tiddlywiki

<!-- Tab "Map" of a location (viewtemplates/location): the map as a graph (graph/map, template
     graph/templates/dnd-map) with its buttons - over the map image (field map) if there is one,
     otherwise on an empty canvas -, below it the spots of the location with their texts, from
     the parse tree of the body (dnd-body, widgets/sections.js): the procedure spot draws the
     heading and jump mark "spot-<name>", a locked spot shows only to a view that sees it.
     Buttons: "Fit map" (message dnd-map-fit through a messagerelay into the graph), "Hide
     nodes"/"Show nodes" ($:/state/dndwiki-core/map-nodes/<title>), "Edit positions"
     ($:/state/dndwiki-core/map-edit/<title>; not in the published copy, off while the nodes are
     hidden). The states are temporary and not saved with the location. -->
\whitespace trim
<$let dnd-relay=<<qualify "dnd-map-relay">>
	dnd-nodes-state={{{ [<currentTiddler>addprefix[$:/state/dndwiki-core/map-nodes/]] }}}
	dnd-edit-state={{{ [<currentTiddler>addprefix[$:/state/dndwiki-core/map-edit/]] }}}
	currentNode=<<currentTiddler>>>
<div class="dnd-map-buttons">
<$messagerelay to=<<dnd-relay>>>
<$button class="tc-btn-invisible dnd-map-button" message="dnd-map-fit"><$text text={{{ [[Map/Fit]dndtranslate[]] }}}/></$button>
</$messagerelay>
<%if [<dnd-nodes-state>get[text]match[hide]] %>
<$button class="tc-btn-invisible dnd-map-button"><$action-deletetiddler $tiddler=<<dnd-nodes-state>>/><$text text={{{ [[Map/ShowNodes]dndtranslate[]] }}}/></$button>
<%else%>
<$button class="tc-btn-invisible dnd-map-button"><$action-setfield $tiddler=<<dnd-nodes-state>> text="hide"/><$action-deletetiddler $tiddler=<<dnd-edit-state>>/><$text text={{{ [[Map/HideNodes]dndtranslate[]] }}}/></$button>
<%endif%>
<%if [{$:/status/IsReadOnly}!match[yes]] %>
<%if [<dnd-nodes-state>get[text]match[hide]] %>
<span class="dnd-map-button dnd-map-button-off"><$text text={{{ [[Map/Edit]dndtranslate[]] }}}/></span>
<%elseif [<dnd-edit-state>get[text]match[yes]] %>
<$button class="tc-btn-invisible dnd-map-button dnd-map-button-on"><$action-deletetiddler $tiddler=<<dnd-edit-state>>/><$text text={{{ [[Map/EditDone]dndtranslate[]] }}}/></$button>
<%else%>
<$button class="tc-btn-invisible dnd-map-button"><$action-setfield $tiddler=<<dnd-edit-state>> text="yes"/><$text text={{{ [[Map/Edit]dndtranslate[]] }}}/></$button>
<%endif%>
<%endif%>
</div>
<div class="dnd-map">
<%if [{$:/info/browser}match[yes]] %>
<$graph.view $tiddler="$:/plugins/dndwiki-core/graph/map" $mode=inline>
<$messagerelay name=<<dnd-relay>>/>
</$graph.view>
<%endif%>
</div>
<div class="dnd-spots">
<$dnd-body $tiddler=<<currentTiddler>> $mode="block" $only="spot"/>
</div>
</$let>

title: $:/plugins/dndwiki-core/viewtemplates/location/battlemap
type: text/vnd.tiddlywiki

<!-- Tab content of a battle map (viewtemplates/location): the image <<currentTab>> stands for
     (filter maptabs), scaled to the width; a click opens the original file. -->
<$let dnd-file={{{ [<currentTiddler>maptabs[]] :filter[jsonget[id]match<currentTab>] +[first[]jsonget[file]] }}}
	dnd-path={{{ [<dnd-file>addprefix[images/battlemap/]] }}}>
<div align="center"><a class="dnd-battlemap" href={{{ [<dnd-path>encodeuri[]] }}} target="_blank" rel="noopener noreferrer"><$image source=<<dnd-path>>/></a></div>
</$let>

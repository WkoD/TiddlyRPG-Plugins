<!-- The events of a tiddler (tabs "Timeline"/"List"): those that link to it or are tagged with
     it. For a location also those of every place within it, at any depth ("liegt in" and spots,
     filters/location.js), and those that reference one of these places with <<spotlink>>
     (filter spotlinked) - an event in Baile is an event in the Kingdom. -->
\function dnd.places() [<self>] [<self>tag[Location]sublocations:all[]]

<$reveal tag="div" class="tc-tiddler-body" type="nomatch" stateTitle=<<folded-state>> text="hide" retain="yes" animate="yes">
<%if [<currentTiddler>dnd.visible[]] %>
<$list filter="[all[current]!is[system]!untagged[]!tag[Event]!tag[Index]!tag[Information]]">

<hr>
<$let self=<<currentTiddler>> dnd-events="[dnd.places[]backlinks[]] [dnd.places[]spotlinked[]] [dnd.places[]tagging[]] +[tag[Event]]">
{{||$:/plugins/dndwiki-core/viewtemplates/event-list/tabs}}
</$let>
<hr>
</$list>
<%endif%>
</$reveal>

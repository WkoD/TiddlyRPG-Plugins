/* Date line below the tags (procedure dnd.dateline: span of an event, years of existence of the
   other types; grey like the date line of a timeline card), head of an event
   (viewtemplates/event), dated sections in the body (procedure date), location pills (procedure
   dnd.places) and hints on dates that cannot be read (dnd.datecheck). Palette colours via
   --tpc-*. */
.dnd-dateline {
	text-align: right;
	color: var(--tpc-muted-foreground, #999);
	font-size: 0.85em;
	line-height: 1.3;
}
.dnd-date-heading {
	font-weight: bold;
}
.dnd-date-label {
	font-weight: normal;
}
.dnd-date-rule {
	margin: 1.2em 0 0.8em;
}
.dnd-date-heading + .dnd-places {
	margin-top: 0.2em;
}
.dnd-places {
	display: flex;
	flex-wrap: wrap;
	gap: 3px 4px;
	margin-bottom: 0.6em;
}
.dnd-places a.tc-tiddlylink {
	text-decoration: none;
}
.dnd-date-invalid {
	color: var(--tpc-alert-highlight, #b00);
	font-size: 0.85em;
}

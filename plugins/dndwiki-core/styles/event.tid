/* Span above the title of an event (templates/title-event, the style of the date line of a
   timeline card), head of an event (viewtemplates/event), dated sections in the body (procedure date),
   location pills (procedure dnd.places), hints on dates that cannot be read (dnd.datecheck)
   and the years of existence (viewtemplates/activity). Palette colours via --tpc-*. */
.dnd-event-span {
	color: var(--tpc-muted-foreground, #999);
	font-size: 0.85em;
	line-height: 1.3;
}
/* In the title bar (font-size 2.35em in the vanilla theme): the size of the subtitle */
.tc-titlebar .dnd-event-span {
	font-size: 0.38em;
	font-weight: normal;
	margin-bottom: 0.15em;
}
.dnd-date-heading {
	font-weight: bold;
}
.dnd-date-label {
	font-weight: normal;
}
.dnd-date-rule {
	margin: 1.2em 0 0.8em;
}
.dnd-date-heading + .dnd-places {
	margin-top: 0.2em;
}
.dnd-places {
	display: flex;
	flex-wrap: wrap;
	gap: 3px 4px;
	margin-bottom: 0.6em;
}
.dnd-places a.tc-tiddlylink {
	text-decoration: none;
}
.dnd-date-invalid {
	color: var(--tpc-alert-highlight, #b00);
	font-size: 0.85em;
}
.dnd-activity {
	text-align: right;
	font-size: 0.85em;
	font-style: italic;
}

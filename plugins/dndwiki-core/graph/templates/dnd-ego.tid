caption: DnD ego graph (1 hop, type colours)
created: 20260708125907000
modified: 20261006064449000
title: $:/plugins/dndwiki-core/graph/templates/dnd-ego

\whitespace trim

\procedure dnd.node()
<$wikify name=label mode=inline text={{{ [{!!title}get[caption]else[<$text text={{!!title}} />]] }}}>
<$node label=<<label>> image={{!!icon}} />
</$wikify>
\end dnd.node

<!-- Ego network around <<currentNode>>: centre + 1-hop neighbours (entities + items).
     No persistence, physics on. Colours from the type tags, grey (dead/dissolved) as the
     innermost level. Automatic edges tags/list/links/transcludes hidden. Edge labels are
     translated by the override of $edges.typed.
     A location as centre (filters/location.js): its spots that are locations ("Teil von") count
     as the centre too, with their neighbours. All places within it (every depth, both kinds)
     are nodes too, with their edges among each other. A place that has someone there or a
     leader starts folded ("▸ Baile"): a single click unfolds it ("▾ Baile") and adds its
     neighbours, another click folds it again (graph/ego-toggle.js; the unfolded places are in
     the field list of $:/state/dndwiki-core/ego-open/<centre>, temporary). A double click opens
     the tiddler as everywhere. Other locations are left out; the parent is in the path below
     the title. -->


<$graph>
<$properties $for=graph $tiddler="$:/config/dndwiki/graph/physics" />
<$properties $for=nodes actions="<$action-navigate $to=<<nodeTiddler>> />">
<$properties physics=yes shape=box>

<$properties $filter="[tag[Event]]"      color={{Event!!color}}>
<$properties $filter="[tag[Deity]]"           color={{Deity!!color}}>
<$properties $filter="[tag[Location]]"            color={{Location!!color}}>
<$properties $filter="[tag[Artifact]] [tag[Book]] [tag[Item]] [tag[Material]]" color={{Item!!color}}>
<$properties $filter="[tag[Person]]"         color={{Person!!color}}>
<$properties $filter="[tag[Player]]"        color={{Player!!color}}>
<$properties $filter="[tag[Organisation]]"   color={{Organisation!!color}}>
<$properties $filter="[tag[Person]dnd.dead[]]"       color="#dddddd" borderColor={{Person!!color}}>
<$properties $filter="[tag[Player]dnd.dead[]]"      color="#dddddd" borderColor={{Player!!color}}>
<$properties $filter="[tag[Organisation]dnd.dead[]]" color="#dddddd" borderColor={{Organisation!!color}}>
<$properties $filter="[tag[Artifact]] [tag[Book]] [tag[Item]] [tag[Material]] +[dnd.dead[]]" color="#dddddd" borderColor={{Item!!color}}>

<$let dnd-centre={{{ [<currentNode>] [<currentNode>tag[Location]sublocations:all[spot]] +[format:titlelist[]join[ ]] }}}
	dnd-open-state={{{ [<currentNode>addprefix[$:/state/dndwiki-core/ego-open/]] }}}
	dnd-open={{{ [<currentNode>addprefix[$:/state/dndwiki-core/ego-open/]get[list]enlist-input[]] :intersection[<currentNode>tag[Location]sublocations:all[]] -[enlist<dnd-centre>] +[format:titlelist[]join[ ]] }}}>

<$list filter="[enlist<dnd-centre>]">
<<dnd.node>>
<$edges.typed $fields="[all[]] -[[tags]] -[[list]]" $functions="[all[]] -[[links]] -[[transcludes]]" />
</$list>

<%if [<currentNode>tag[Location]] %>
<$list filter="[<currentNode>sublocations:all[]] -[enlist<dnd-centre>]">
<%if [<currentTiddler>occupants[]] [<currentTiddler>listed[leader]] +[first[]] %>
<$node label={{{ [enlist<dnd-open>match<currentTiddler>then[▾ ]else[▸ ]addsuffix<currentTiddler>] }}} dndToggle=<<dnd-open-state>> />
<%else%>
<<dnd.node>>
<%endif%>
<$edges.typed $fields="location" $functions="spots" />
</$list>
<$nodes.neighbors
  $filter="[enlist<dnd-centre>] [enlist<dnd-open>]"
  $fields="[all[]] -[[tags]] -[[list]]"
  $functions="[all[]] -[[links]] -[[transcludes]]"
  $whitelist="[!is[system]!is[draft]] -[tag[Location]]"
  $interedges="yes" />
<%else%>
<$nodes.neighbors
  $filter="[<currentNode>]"
  $fields="[all[]] -[[tags]] -[[list]]"
  $functions="[all[]] -[[links]] -[[transcludes]]"
  $interedges="yes" />
<%endif%>

</$let>

</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$graph>

caption: DnD map (map image as background, spots placed by hand)
created: 20261006064449000
modified: 20261007163804094
title: $:/plugins/dndwiki-core/graph/templates/dnd-map

\whitespace trim

\procedure dnd.node()
<$wikify name=label mode=inline text={{{ [{!!title}get[caption]else[<$text text={{!!title}} />]] }}}>
<$node label=<<label>> image={{!!icon}} />
</$wikify>
\end dnd.node

\procedure dnd.save()
<$let dnd-xy={{{ [<x>addsuffix[,]addsuffix<y>] }}}>
<$action-setfield $tiddler=<<dnd-loc>> map-positions={{{ [<dnd-loc>get[map-positions]else[{}]jsonset<nodeTiddler>,<dnd-xy>] }}}/>
</$let>
\end dnd.save

\procedure dnd.fixed(id)
\whitespace trim
<$let dnd-pos={{{ [<dnd-loc>get[map-positions]jsonget<id>] }}}
	dnd-x={{{ [<dnd-pos>split[,]first[]] }}}
	dnd-y={{{ [<dnd-pos>split[,]last[]] }}}>
<%if [<dnd-pos>!is[blank]] %>
<$properties x=<<dnd-x>> y=<<dnd-y>> physics="no"><$slot $name="ts-raw"/></$properties>
<%else%>
<$properties physics="no" dndUnplaced="yes"><$slot $name="ts-raw"/></$properties>
<%endif%>
</$let>
\end dnd.fixed

<!-- Map of the location <<currentNode>> (viewtemplates/location/map): its map image (field map,
     images/map/) as background, always 600 units wide and fitted to the width (vis-property
     dnd-map-fit, graph/map-fit.js); without an image
     an empty canvas fitted to the nodes. Fixed at the
     positions saved in its field map-positions ("x,y" per node id, map units - the image is 600 wide - with
     the origin in the middle; a node without a saved position gets a grid slot): its spots (a spot joined to a tiddler is that
     tiddler, any other one a dot with the id <location>#<plain name>) and the locations lying
     in it ("liegt in", all levels) - not the location itself. Only places: who is there or
     leads them is left out. Each is a pin (graph/map-pin.js): a dot at the position, the name in
     a pill below it - filled for a tiddler, white and dashed for a spot without a tiddler of its
     own. A double click on such a spot scrolls to its text below the map, on any other node it
     opens the tiddler; hovering shows the text. No edges: where a place lies, the map shows.
     States per location: $:/state/dndwiki-core/map-nodes/<title> = hide (only the image),
     $:/state/dndwiki-core/map-edit/<title> = yes (nodes can be moved; dropping one saves its
     position - never in the published copy). -->

<$let dnd-loc=<<currentNode>>
	dnd-hidden={{{ [<dnd-loc>addprefix[$:/state/dndwiki-core/map-nodes/]get[text]match[hide]] }}}
	dnd-edit={{{ [<dnd-loc>addprefix[$:/state/dndwiki-core/map-edit/]get[text]match[yes]] :filter[{$:/status/IsReadOnly}!match[yes]] }}}
	dnd-places={{{ [<dnd-loc>sublocations:all[location]] :filter[dnd.visible[]] +[format:titlelist[]join[ ]] }}}>
<$graph>
<$properties $for=graph $tiddler="$:/config/dndwiki/graph/physics" />
<$properties $for=graph dndMapImage={{{ [<dnd-loc>get[map]encodeuri[]addprefix[images/map/]] }}} dndMapFit={{{ [<dnd-loc>has[map]then[image]else[nodes]] }}} />
<!-- tw5-graph hands a node event to every enclosing $properties as well: open only real
     tiddlers, not the dots of spots (their own action jumps to their text) -->
<$properties $for=nodes actions="<$list filter='[<nodeTiddler>is[tiddler]] [<nodeTiddler>is[shadow]] +[first[]]' variable='dnd-open'><$action-navigate $to=<<dnd-open>>/></$list>">
<$properties.popup $enabled="yes">
<$fill $name="tooltip">
<%if [<nodeTiddler>prefix<dnd-loc>removeprefix<dnd-loc>prefix[#]] %>
<$let dnd-name={{{ [<nodeTiddler>removeprefix<dnd-loc>removeprefix[#]] }}}>
<$let dnd-t={{{ [<dnd-loc>spottext<dnd-name>] }}}>
<$transclude $variable="dnd-t" $mode="block"/>
</$let>
</$let>
<%else%>
<$transclude $tiddler=<<nodeTiddler>> $mode="block"/>
<%endif%>
</$fill>
<$properties physics=yes shape=box>

<$slot $name=ts-raw $depth=4 />

<$properties $filter="[tag[Location]]"            color={{Location!!color}}>
<$properties $filter="[tag[Deity]]"           color={{Deity!!color}}>
<$properties $filter="[tag[Person]]"         color={{Person!!color}}>
<$properties $filter="[tag[Player]]"        color={{Player!!color}}>
<$properties $filter="[tag[Organisation]]"   color={{Organisation!!color}}>
<$properties $filter="[tag[Person]dnd.dead[]]"       color="#dddddd" borderColor={{Person!!color}}>
<$properties $filter="[tag[Organisation]dnd.dead[]]" color="#dddddd" borderColor={{Organisation!!color}}>

<%if [<dnd-hidden>is[blank]] %>

<!-- fixed: the locations lying in it, the spots -->
<$properties fixed={{{ [<dnd-edit>match[yes]then[no]else[yes]] }}} free={{{ [<dnd-edit>match[yes]then<dnd.save>] }}} dndPin="tiddler">
<$list filter="[enlist<dnd-places>]">
<$transclude $variable="dnd.fixed" id=<<currentTiddler>>><<dnd.node>></$transclude>
</$list>
<$list filter="[<dnd-loc>spots:raw[]]" variable="dnd-spot">
<$let dnd-plain={{{ [<dnd-spot>spotplain[]] }}}
	dnd-joined={{{ [<dnd-spot>spottarget[]] -[enlist<dnd-places>] :filter[dnd.visible[]] }}}>
<%if [<dnd-joined>!is[blank]] %>
<$tiddler tiddler=<<dnd-joined>>>
<$transclude $variable="dnd.fixed" id=<<dnd-joined>>><<dnd.node>></$transclude>
</$tiddler>
<%elseif [<dnd-spot>spottarget[]count[]match[0]] %>
<$let dnd-id={{{ [<dnd-loc>addsuffix[#]addsuffix<dnd-plain>] }}}>
<$transclude $variable="dnd.fixed" id=<<dnd-id>>>
<$node $tiddler=<<dnd-id>> label=<<dnd-plain>> dndPin="spot" color="#ffffff" borderColor={{Location!!color}}
	actions="<$action-dnd-jump $tiddler=<<dnd-loc>> $anchor={{{ [<nodeTiddler>removeprefix<dnd-loc>removeprefix[#]spotanchor[]] }}}/>" />
</$transclude>
</$let>
<%endif%>
</$let>
</$list>
</$properties>

<%endif%>

</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties.popup>
</$properties>
</$graph>
</$let>

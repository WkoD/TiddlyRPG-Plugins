caption: DnD graph (type colours, no saved positions)
created: 20260708125907000
modified: 20261001095424000
title: $:/plugins/dndwiki-core/graph/templates/dnd-graph

\whitespace trim

\procedure dnd.node()
<$wikify name=label mode=inline text={{{ [{!!title}get[caption]else[<$text text={{!!title}} />]] }}}>
<$node label=<<label>> image={{!!icon}} />
</$wikify>
\end dnd.node

<!-- Like live-graph: no $properties.persistent -> no positions are saved.
     Node colour comes from the colour of the type tag ({{Person!!color}} etc.); grey
     (dead/dissolved, dnd.dead) as the innermost, highest priority. No per-node !!color -> the tag
     colour rules uniformly, changing it recolours all nodes of the type.
     Edge labels are translated (Field/<field>) by the override of $edges.typed in dndwiki-core. -->

<$set name="focusTiddler" filter="[subfilter{!!filter}]">
<$graph>
<$properties $for=graph $tiddler="$:/config/dndwiki/graph/physics" />
<$properties $for=nodes actions="<$action-navigate $to=<<nodeTiddler>> />">
<$properties.settings>
<$properties physics=yes shape=box>

<$slot $name=ts-raw $depth=5 />

<$properties $filter="[tag[Event]]"      color={{Event!!color}}>
<$properties $filter="[tag[Deity]]"           color={{Deity!!color}}>
<$properties $filter="[tag[Location]]"            color={{Location!!color}}>
<$properties $filter="[tag[Artifact]] [tag[Book]] [tag[Item]] [tag[Material]]" color={{Item!!color}}>
<$properties $filter="[tag[Person]]"         color={{Person!!color}}>
<$properties $filter="[tag[Player]]"        color={{Player!!color}}>
<$properties $filter="[tag[Organisation]]"   color={{Organisation!!color}}>
<$properties $filter="[tag[Person]dnd.dead[]]"       color="#dddddd" borderColor={{Person!!color}}>
<$properties $filter="[tag[Player]dnd.dead[]]"      color="#dddddd" borderColor={{Player!!color}}>
<$properties $filter="[tag[Organisation]dnd.dead[]]" color="#dddddd" borderColor={{Organisation!!color}}>
<$properties $filter="[tag[Artifact]] [tag[Book]] [tag[Item]] [tag[Material]] +[dnd.dead[]]" color="#dddddd" borderColor={{Item!!color}}>

<$list filter={{!!filter}}>
<<dnd.node>>
<$edges.typed />
</$list>

</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties.settings>
</$properties>
</$graph>
</$set>

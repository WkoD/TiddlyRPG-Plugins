title: $:/plugins/dndwiki-core/templates/tags
type: text/vnd.tiddlywiki

\whitespace trim
<!-- Tag area of a tiddler, chosen by config/view-tags (cascade $:/tags/ViewTemplateTagsFilter)
     instead of $:/core/ui/ViewTemplate/tags/default: nothing for a tiddler the active view does
     not see, no pill of a tag it does not see, and the dropdown of a pill (templates/tag) lists
     only what it sees (modules/visibility.js). -->
<$reveal type="nomatch" stateTitle=<<folded-state>> text="hide" tag="div" retain="yes" animate="yes">
<%if [<currentTiddler>dnd.visible[]] %>
<div class="tc-tags-wrapper">
<$list filter="[all[current]tags[]] :filter[dnd.visible[]] +[sort[title]]" template="$:/plugins/dndwiki-core/templates/tag" storyview="pop"/>
<$list filter="[all[shadows+tiddlers]tag[$:/tags/ViewTemplate/Tags]!has[draft.of]]">
<$transclude mode="inline"/>
</$list>
</div>
<%endif%>
</$reveal>

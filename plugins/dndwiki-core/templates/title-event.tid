title: $:/plugins/dndwiki-core/templates/title-event
type: text/vnd.tiddlywiki

\whitespace trim
<!-- Heading of an event (cascade entry config/title-event): the span of its date field above
     the title, in the style of the date line of its timeline card; the title as display name
     (like templates/title-translated). The span is left out for an event locked for the
     logged-in player. -->
<%if [<currentTiddler>dnd.visible[]] %>
<$let dnd-text={{{ [<currentTiddler>get[date]dateformat:era[]] }}}>
<%if [<dnd-text>!is[blank]] %><div class="dnd-event-span"><$text text=<<dnd-text>>/></div><%endif%>
</$let>
<%endif%>
<h2 class="tc-title">
<$text text={{{ [<currentTiddler>dndtitle[]] }}}/>
</h2>

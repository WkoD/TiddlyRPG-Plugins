title: $:/plugins/flibbles/graph/macros/edges.typed

\widget $edges.typed($editable:no)
\whitespace trim
<$parameters
	$$functions={{{ [<functionsFilter>!is[blank]] ~"[all[]]" }}}
	$$fields={{{ [<fieldsFilter>!is[blank]] ~"[all[]]" }}}
	$$tiddler=<<currentTiddler>> >

<!-- First create edges for field types -->

<$list variable=fieldName filter="+[subfilter{$:/plugins/flibbles/graph/subfilters##edgetypes.fields}subfilter<$fields>]">

<$let
	dataTiddler=`$:/config/flibbles/graph/edges/fields/$(fieldName)$`
	dndExclude={{{ [<fieldName>addprefix[$:/config/flibbles/graph/edges/fields/]get[dndwiki-exclude]] }}}
	dndSymmetric={{{ [<fieldName>addprefix[$:/config/flibbles/graph/edges/fields/]get[dndwiki-symmetric]] }}} >

<$properties $for=edges
	$tiddler=<<dataTiddler>>
	delete={{{ [<$editable>!match[no]then[<$action-removetyped $tiddler=<<fromTiddler>> $field=<<fieldName>> $value=<<toTiddler>> />]] }}} >

<!-- dndwiki-core: translated edge label from the language key Field/<field>, only for edge
     types whose config has a label; nested inside the config so that it wins -->
<$properties $for=edges
	label={{{ [<dataTiddler>getindex[label]!is[blank]then<fieldName>addprefix[Field/]dndtranslate[]] }}} >


<!-- dndwiki-core: the field config may name targets that this field type does not draw
     (field dndwiki-exclude, a filter); another edge type draws them, e.g. leader -> location
     is the function edge "rules" -->
<$list variable=toTiddler counter=index filter="[<$tiddler>] :map:flat[gettyped<fieldName>] +[!is[blank]] -[subfilter<dndExclude>]">

<!-- dndwiki-core: a symmetric field type (field dndwiki-symmetric of the config) is kept on
     both ends; if the other end points back, both ends give the edge the same id - ordered
     pair and field - so the graph keeps one edge, with arrows on both ends. One end alone keeps
     its own id and a plain arrow. -->
<$let
	dndBoth={{{ [<dndSymmetric>match[yes]then<toTiddler>] :map:flat[gettyped<fieldName>] +[match<$tiddler>] }}}
	dndFirst={{{ [<$tiddler>] [<toTiddler>] +[sortcs[]first[]] }}}
	dndLast={{{ [<$tiddler>] [<toTiddler>] +[sortcs[]last[]] }}} >

<$vars
	dndPairId=`$:/edge/fields/$(dndFirst)$
$(dndLast)$
$(fieldName)$`
	dndOwnId=`$:/edge/fields/$($tiddler)$
$(fieldName)$-$(index)$`>

<$vars id={{{ [<dndBoth>!is[blank]then<dndPairId>] ~[<dndOwnId>] }}}>

<$properties $for=edges
	arrows={{{ [<dndBoth>!is[blank]then[to from]] }}} >

<$slot $name=ts-raw>

<$edge $from=<<$tiddler>> $id=<<id>> />

</$slot></$properties></$vars></$vars></$let></$list></$properties></$properties></$let></$list>

<!-- Now create edges for function types -->

<$list variable=functionName filter="[subfilter{$:/plugins/flibbles/graph/subfilters##edgetypes.functions}subfilter<$functions>]">

<$let
	dataTiddler=`$:/config/flibbles/graph/edges/functions/$(functionName)$`
	function={{{ [<dataTiddler>get[filter]] }}} >

<$properties $for=edges
	$tiddler=<<dataTiddler>> >

<!-- dndwiki-core: translated label from Field/<function>, as for the field types -->
<$properties $for=edges
	label={{{ [<dataTiddler>getindex[label]!is[blank]then<functionName>addprefix[Field/]dndtranslate[]] }}} >

<$list variable=toTiddler counter=index filter="[<$tiddler>] :map:flat[subfilter<function>] +[!is[blank]]">

<$vars id=`$:/edge/functions/$($tiddler)$
$(functionName)$-$(index)$`>

<$slot $name=ts-raw>

<$edge $from=<<$tiddler>> $id=<<id>> />

</$slot></$vars></$list></$properties></$properties></$let></$list>
\end

\relink $edges.typed $functions:filter $fields:filter $tiddler:title

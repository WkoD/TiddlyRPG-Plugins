<!-- Shared checks of the format layer. They work on their input and are called as filter
     operators, e.g. [<currentTiddler>dnd.dead[]] - so they behave the same in ViewTemplates,
     cascades, ClassFilters and graph templates. -->

<!-- Lock: the input titles the active view ($:/state/dndwiki/view) sees - every tiddler, except
     one tagged Secret: that only the DM and the players of the player characters it is tagged
     with (modules/visibility.js). -->
\function dnd.visible() [dndvisible[]]

<!-- Deceased/destroyed: the date field ends (last section a range with an end other than
     "..", modules/dates.js). Events excluded - their sections are points and spans in time. -->
\function dnd.dead() [!is[system]!tag[Event]] :filter[get[date]dateended[]]

<!-- Language system (modules/language.js): translation of a key, display name of a title,
     plural of a type. Missing keys fall back to en-GB, then to the key/title itself. -->
\function dnd.t(key) [<key>dndtranslate[]]
\function dnd.title(title) [<title>dndtitle[]]
\function dnd.plural(type) [<type>addprefix[Plural/]dndtranslate[]]

<!-- Date output through the calendar engine (filters/date.js). Procedures with filtered
     attributes, so that they recompute when the language or the calendar data changes. -->

<!-- Short form of a date field or of one of its sections, with the era -->
\procedure dateformat(date,section)
<$text text={{{ [<date>dateformat:era<section>] }}}/>
\end

\procedure dateadd(date,days)
<$text text={{{ [<date>dateadd<days>] }}}/>
\end

\procedure datediff(from,to)
<$text text={{{ [<from>datediff<to>] }}}/>
\end

<!-- Locations linked in a section of the body of the current tiddler (0 = before the first
     <<date>>), without those the active view does not see; as pills, nothing if none. A
     <<spotlink>> in the section gives a pill "Spot (Location)" that jumps to the spot. -->
\procedure dnd.places(section)
\whitespace trim
<$let dnd-places={{{ [<currentTiddler>sectionlinks<section>tag[Location]] :filter[dnd.visible[]] +[sort[]format:titlelist[]join[ ]] }}}
	dnd-spotrefs={{{ [<currentTiddler>sectionspots<section>] :filter[jsonget[place]dnd.visible[]] +[format:titlelist[]join[ ]] }}}>
<%if [enlist<dnd-places>] [enlist<dnd-spotrefs>] +[first[]] %>
<div class="dnd-places">
<$list filter="[enlist<dnd-places>]" variable="dnd-place">
<$link to=<<dnd-place>>><$transclude $variable="tag-pill" tag=<<dnd-place>>/></$link>
</$list>
<$list filter="[enlist<dnd-spotrefs>]" variable="dnd-ref">
<$transclude $variable="dnd.spotpill" place={{{ [<dnd-ref>jsonget[place]] }}} spot={{{ [<dnd-ref>jsonget[spot]] }}}/>
</$list>
</div>
<%endif%>
</$let>
\end

<!-- Pill of a <<spotlink>> in a section: "Spot (Location)" in the colour of the location;
     opens the tiddler the spot is joined to, or the location at the spot in its map tab -->
\procedure dnd.spotpill(place,spot)
\whitespace trim
<$let dnd-colour={{{ [<place>] :cascade[all[shadows+tiddlers]tag[$:/tags/TiddlerColourFilter]!is[draft]get[text]] }}}
	dnd-label={{{ [<place>spots[]match<spot>then<spot>addsuffix[ (]addsuffix<place>addsuffix[)]] ~[<place>] }}}>
<$transclude $variable="dnd.spotjump" place=<<place>> spot=<<spot>>>
<span class="tc-tag-label dnd-spot-pill" style.background-color=<<dnd-colour>>><$text text=<<dnd-label>>/></span>
</$transclude>
\end

<!-- Link around the slot content to a spot: the tiddler the spot is joined to; else the
     location, switched to its map tab and scrolled to the spot (widgets/jump.js); else the
     location alone (missing spot) -->
\procedure dnd.spotjump(place,spot)
\whitespace trim
<$let dnd-joined={{{ [<spot>spottarget[]] }}}>
<%if [<dnd-joined>!is[blank]] %>
<$link to=<<dnd-joined>>><$slot $name="ts-raw"/></$link>
<%elseif [<place>spots[]match<spot>] %>
<$dnd-jump anchor={{{ [<spot>spotanchor[]] }}} tabstate={{{ [<place>addprefix[$:/state/dndwiki-core/location-tab/]] }}} tab="map"><$link to=<<place>>><$slot $name="ts-raw"/></$link></$dnd-jump>
<%else%>
<$link to=<<place>>><$slot $name="ts-raw"/></$link>
<%endif%>
</$let>
\end

<!-- Date line below the tags of every tiddler with dates, right-aligned: an event shows the span
     of its date field ("????" with the era if it has none), every other type its years of
     existence (mode "year", nothing without dates). With the hint on a date that cannot be read. -->
\procedure dnd.dateline(mode)
\whitespace trim
<%if [<mode>match[year]] %>
<$let dnd-text={{{ [<currentTiddler>get[date]dateformat:year,era[]] }}}>
<%if [<dnd-text>!is[blank]] %><div class="dnd-dateline"><$text text=<<dnd-text>>/></div><%endif%>
</$let>
<%else%>
<div class="dnd-dateline"><$text text={{{ [<currentTiddler>visibledate[]dateformat:era[]!is[blank]] ~[calendar[era]!is[blank]addprefix[???? ]] ~[[????]] }}}/></div>
<%endif%>
<<dnd.datecheck>>
\end

<!-- Hint for the editor if the date field of the current tiddler cannot be read or names a
     day the calendar does not have; not in the published (read-only) copy -->
\procedure dnd.datecheck()
\whitespace trim
<$list filter="[<currentTiddler>get[date]datecheck[]] :filter[[yes]!match{$:/status/IsReadOnly}]" variable="dnd-raw">
<div class="dnd-date-invalid"><$text text={{{ [[Date/Invalid]dndtranslate[]] }}}/> <code><$text text=<<dnd-raw>>/></code></div>
</$list>
\end

<!-- A dated section in the body: <<date>> is the next section of the date field (the first
     is 1), <<date 3>> section 3, <<date "Caption">> / <<date 3 "Caption">> with a caption.
     Draws the rule before it (not at the very start of the body), the date, the caption and
     the locations of the section. widgets/date.js finds out which section it is. Without any
     date in the field the heading is "????" (with the era). The heading is the jump mark
     "date-<n>" (data-dnd-anchor, modules/anchor-jump.js) - not at the very start of the body:
     there a jump would only hide the title, the plain navigation already shows the section. -->
\procedure date(n,label)
\whitespace trim
<$dnd-date n=<<n>> label=<<label>>>

<%if [<dnd-section>is[blank]] %>
<div class="dnd-date-invalid"><$text text={{{ [[Date/SectionHint]dndtranslate[]] }}}/></div>
<%else%>
<$let dnd-dated={{{ [<currentTiddler>get[date]trim[]] }}}
	dnd-text={{{ [<currentTiddler>get[date]dateformat:era<dnd-section>!is[blank]] ~[<dnd-dated>is[blank]then[????]] }}}
	dnd-era={{{ [<dnd-dated>is[blank]] :then[calendar[era]!is[blank]addprefix[ ]] }}}
	dnd-anchor={{{ [<dnd-first>!match[yes]] :then[<dnd-section>addprefix[date-]] }}}>

<%if [<dnd-first>!match[yes]] %><hr class="dnd-date-rule"/><%endif%>
<%if [<dnd-text>is[blank]] %>
<div class="dnd-date-invalid" data-dnd-anchor=<<dnd-anchor>>><$text text={{{ [[Date/SectionMissing]dndtranslate[]search-replace[$n$],<dnd-section>] }}}/></div>
<%else%>
<div class="dnd-date-heading" data-dnd-anchor=<<dnd-anchor>>><$text text=<<dnd-text>>/><$text text=<<dnd-era>>/><%if [<dnd-label>!is[blank]] %><span class="dnd-date-label"><$text text={{{ [<dnd-label>addprefix[ – ]] }}}/></span><%endif%></div>
<%endif%>
<$transclude $variable="dnd.places" section=<<dnd-section>>/>

</$let>
<%endif%>

</$dnd-date>
\end

<!-- A lock: <<secret "Theren" "Actia">> locks the section it stands at (modules/sections.js),
     <$secret for="...">...</$secret> what it encloses (widgets/sections.js). Draws nothing itself:
     the section shows the marker for whom it is. -->
\procedure secret()
\end

<!-- A spot of a location (modules/spots.js): <<spot "Name">>, <<spot "Tempel von [[Chauntea]]">>,
     <<spot "Name" "Tiddler">>, <<spot "Name" battlemap:"a.jpg">>. Draws the heading of the
     spot with the jump mark "spot-<name>". Joined to a tiddler (the second parameter, or a
     tiddler with the plain name), the heading links to it; otherwise the name is rendered as
     wikitext, links in it stay links. Its text and its place on the map come from the parse
     tree, not from this procedure. -->
\procedure spot(name,target,battlemap)
\whitespace trim
<$let dnd-target={{{ [<name>spottarget<target>] }}}>
<h3 class="dnd-spot" data-dnd-anchor={{{ [<name>spotanchor[]] }}}>
<%if [<dnd-target>!is[blank]] %>
<$link to=<<dnd-target>>><$text text={{{ [<name>spotplain[]] }}}/></$link>
<%else%>
<$transclude $variable="name" $mode="inline"/>
<%endif%>
</h3>
</$let>
\end

<!-- A reference to a spot: <<spotlink "Baile" "Schloss Baile">> or
     <<spotlink "Miehall" "[[Trunkenen Eulenbären|Zum Trunkenen Eulenbären]]">> (text before
     "|", spot after it). A spot joined to a tiddler opens that tiddler, any other spot the
     location at the spot; a spot or location that does not exist gives a hint for the editor
     (not in the published copy). The section pills (dnd.places) show it as well. -->
\procedure spotlink(place,spot)
\whitespace trim
<$let dnd-spot={{{ [<spot>spotref:spot[]] }}}
	dnd-text={{{ [<spot>spotref:text[]] }}}>
<$transclude $variable="dnd.spotjump" place=<<place>> spot=<<dnd-spot>>><$text text=<<dnd-text>>/></$transclude>
<$transclude $variable="dnd.spotcheck" place=<<place>> spot=<<dnd-spot>>/>
</$let>
\end

<!-- Hint for the editor on a <<spotlink>> whose location or spot does not exist; not in the
     published (read-only) copy -->
\procedure dnd.spotcheck(place,spot)
\whitespace trim
<%if [{$:/status/IsReadOnly}!match[yes]] %>
<%if [<place>!is[tiddler]!is[shadow]] %>
<span class="dnd-date-invalid"> <$text text={{{ [[Spot/PlaceMissing]dndtranslate[]search-replace[$place$],<place>] }}}/></span>
<%elseif [<spot>spottarget[]] [<place>spots[]match<spot>] +[count[]match[0]] %>
<span class="dnd-date-invalid"> <$text text={{{ [[Spot/Missing]dndtranslate[]search-replace[$spot$],<spot>search-replace[$place$],<place>] }}}/></span>
<%endif%>
<%endif%>
\end

<!-- The parents of a tiddler as a path below its title: "Materielle Ebene › Andu Falas ›
     Königreich von Vandalia" for a location, its location(s) at the end for persons and the
     like (one line per entry), "Kontrolliert: …" for locations it leads; with the hints of
     locationcheck (not in the published copy). What the view does not see is left out: an
     entry it does not see with its whole line, else the line would tell where it lies. -->
\procedure dnd.locationpath()
\whitespace trim
<$let dnd-lines={{{ [<currentTiddler>tag[Location]then<currentTiddler>] ~[<currentTiddler>get[location]enlist-input[]] :filter[dnd.visible[]] +[format:titlelist[]join[ ]] }}}>
<$list filter="[enlist<dnd-lines>]" variable="dnd-line">
<$let dnd-path={{{ [<dnd-line>locationpath[]] [<currentTiddler>!tag[Location]then<dnd-line>] +[!is[blank]] :filter[dnd.visible[]] +[format:titlelist[]join[ ]] }}}>
<%if [enlist<dnd-path>first[]] %>
<div class="dnd-location-path"><$list filter="[enlist<dnd-path>]" variable="dnd-step" counter="dnd-n"><%if [<dnd-n-first>!match[yes]] %><span class="dnd-location-path-sep">›</span><%endif%><$macrocall $name="deadlink" title=<<dnd-step>> style="~~"/></$list></div>
<%endif%>
</$let>
</$list>
<$let dnd-rules={{{ [<currentTiddler>get[leader]enlist-input[]tag[Location]] :filter[dnd.visible[]] +[format:titlelist[]join[ ]] }}}>
<%if [enlist<dnd-rules>first[]] %>
<div class="dnd-location-path dnd-location-rules"><$text text={{{ [[Relations/Rules]dndtranslate[]addsuffix[: ]] }}}/><$list filter="[enlist<dnd-rules>]" variable="dnd-step" counter="dnd-n"><%if [<dnd-n-first>!match[yes]] %><span class="dnd-location-path-sep dnd-location-path-comma">,</span><%endif%><$macrocall $name="deadlink" title=<<dnd-step>> style="~~"/></$list></div>
<%endif%>
</$let>
<$list filter="[<currentTiddler>locationcheck[]] :filter[[yes]!match{$:/status/IsReadOnly}]" variable="dnd-key">
<div class="dnd-date-invalid"><$text text={{{ [<dnd-key>dndtranslate[]] }}}/></div>
</$list>
</$let>
\end

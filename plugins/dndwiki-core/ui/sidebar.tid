<!-- The tabs of the sidebar in place of $:/core/ui/SideBarSegments/tabs (hidden by
     config/sidebar-tabs): the core tabs in the view of the DM; in every other view only
     "Open" and the recently changed tiddlers that view sees (ui/sidebar-recent) - the core lists
     ("Recent", "All", "Tags", "Missing", ...) would name locked tiddlers (modules/visibility.js). -->
<%if [dndview:mode[]match[dm]] %>
<$transclude $tiddler="$:/core/ui/SideBarSegments/tabs" $mode="block"/>
<%else%>
<div class="tc-sidebar-lists tc-sidebar-tabs" role="region" aria-label={{$:/language/SideBar/Caption}}>
<$macrocall $name="tabs" tabsList="[[$:/core/ui/SideBar/Open]] [[$:/plugins/dndwiki-core/ui/sidebar-recent]]" default="$:/core/ui/SideBar/Open" state="$:/state/tab/sidebar-dndwiki" class="tc-sidebar-tabs-main" explicitState="$:/state/tab/sidebar-dndwiki--view"/>
</div>
<%endif%>

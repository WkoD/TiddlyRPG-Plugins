title: Player
type: text/vnd.tiddlywiki

\whitespace trim
<!-- The player characters as cards with portrait, name and player: the active ones (tag
     Player), below them those someone played before (any other tiddler with a field player).
     Which view the wiki shows is chosen in the page controls (ui/view-switcher). -->
\procedure dnd.playercard()
\whitespace trim
<$link to=<<currentTiddler>> class={{{ [<currentTiddler>dnd.dead[]then[dnd-player-card dnd-dead]else[dnd-player-card]] }}}>
<span class="dnd-player-portrait"><$transclude $variable="image" title=<<currentTiddler>>/></span>
<span class="dnd-player-name"><$text text={{{ [<currentTiddler>get[caption]else<currentTiddler>] }}}/></span>
<span class="dnd-player-of"><$text text={{{ [<currentTiddler>get[player]] }}}/></span>
</$link>
\end

<h3><$text text={{{ [[Player/Active]dndtranslate[]] }}}/></h3>
<div class="dnd-players">
<$list filter="[tag[Player]!is[draft]] :filter[dnd.visible[]] +[sort[title]]"><<dnd.playercard>></$list>
</div>
<$list filter="[!is[system]!is[draft]!tag[Player]has[player]] :filter[dnd.visible[]] +[sort[title]] +[limit[1]]" variable="ignore">
<h3><$text text={{{ [[Player/Former]dndtranslate[]] }}}/></h3>
<div class="dnd-players">
<$list filter="[!is[system]!is[draft]!tag[Player]has[player]] :filter[dnd.visible[]] +[sort[title]]"><<dnd.playercard>></$list>
</div>
</$list>
<h3><$text text={{{ [[PlayerLevel]dndtitle[]] }}}/></h3>
<div class="dnd-player-level"><b>{{PlayerLevel}}</b></div>

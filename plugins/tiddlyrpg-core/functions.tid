<!-- Shared checks of the format layer. They work on their input and are called as filter
     operators, e.g. [<currentTiddler>trpg.dead[]] - so they behave the same in ViewTemplates,
     cascades, ClassFilters and graph templates. -->

<!-- Lock: the input titles the active view ($:/state/tiddlyrpg/view) sees - every tiddler, except
     one tagged Secret: that only the DM and the players of the player characters it is tagged
     with (modules/visibility.js). -->
\function trpg.visible() [trpgvisible[]]

<!-- Deceased/destroyed: the date field ends (last section a range with an end other than
     "..", modules/dates.js). Events excluded - their sections are points and spans in time. -->
\function trpg.dead() [!is[system]!tag[Event]] :filter[get[date]dateended[]]

<!-- Link to a tiddler, struck through when it is deceased/destroyed (trpg.dead; class
     trpg-dead-link, stylesheet styles/dead). Used by the type hubs, the relation list and the
     path below the title. -->
\procedure trpg.link(title)
\whitespace trim
<$link to=<<title>> class={{{ [<title>trpg.dead[]then[trpg-dead-link]] }}}/>
\end

<!-- The relations block of <centre> (viewtemplates/relations): its centre (a location with its
     spots that count as itself); what the graph and the list can show around it - its
     neighbours (other locations not for a location), the places within a location, the open
     quests that mention it; for a quest or rumour what its markers mention and the quests linked
     with it -; and the input titles whose kind (relationkind) is switched on.
     The kinds switched off are in the field list of $:/state/tiddlyrpg-core/relations-filter/
     <centre> (not saved); the centre itself always shows. -->
\function trpg.egocentre(centre) [<centre>] [<centre>tag[Location]sublocations:all[spot]] :filter[trpg.visible[]]
\function trpg.egonodes(centre) [trpg.egocentre<centre>relationneighbours[]] :filter[<centre>!tag[Location]] [trpg.egocentre<centre>relationneighbours[]!tag[Location]] [<centre>tag[Location]sublocations:all[]] [trpg.egocentre<centre>questsabout[]] [<centre>questmentions[]is[tiddler]] [<centre>questlinks[]] -[trpg.egocentre<centre>] :filter[trpg.visible[]]
\function trpg.egoshown(centre) [relationkind[]] -[<centre>addprefix[$:/state/tiddlyrpg-core/relations-filter/]get[list]enlist-input[]]

<!-- Switches by kind (the relations block, viewtemplates/relations; the map of a location,
     viewtemplates/location/map): one per kind among <kinds> (a title list of relationkind values)
     - players, persons (with deities), organisations, locations, items (with artifacts and
     materials), quests (with rumours) - in the colour of its hub, split at 45° with the colour of
     the second kind where a switch holds two kinds of a colour of their own, labelled
     Relations/Kind/<hub> then, else with the plural of the hub; all on at first, a click switches
     a kind off and on again: the kinds switched off are in the field list of <state> (not
     saved). trpg.kindshown<state> keeps the input titles whose kind is on. -->
\function trpg.kindshown(state) [relationkind[]] -[<state>get[list]enlist-input[]]

<!-- The open quests and rumours the view sees whose newest marker leads to the map of the location
     <loc> (questpins, modules/quests.js) -->
\function trpg.mapquests(loc) [questnames[]] :filter[queststatus[]match[open]] :filter[questpins<loc>]

\procedure trpg.kindswitch(hub,second,kinds,state)
\whitespace trim
<$let trpg-kind={{{ [<hub>lowercase[]] }}}>
<%if [enlist<kinds>match<trpg-kind>] %>
<$let trpg-on={{{ [<state>get[list]enlist-input[]match<trpg-kind>then[no]else[yes]] }}}>
<$button class={{{ [[trpg-kind-switch]] [<trpg-kind>addprefix[trpg-kind-]] [<second>!is[blank]then[trpg-kind-split]] [<trpg-on>match[no]then[trpg-off]] +[join[ ]] }}}
	style={{{ [<hub>get[color]addprefix[--trpg-kind:]] [<second>!is[blank]addprefix[--trpg-kind2:]] +[join[;]] }}}
	aria-pressed={{{ [<trpg-on>match[yes]then[true]else[false]] }}}
	actions="<$action-listops $tiddler=<<state>> $field='list' $subfilter='+[toggle<trpg-kind>]'/>">
<$text text={{{ [<hub>addprefix[Relations/Kind/]trpgtranslate[]] :filter[!prefix[Relations/Kind/]] ~[trpg.plural<hub>] }}}/>
</$button>
</$let>
<%endif%>
</$let>
\end

\procedure trpg.kindswitches(kinds,state)
\whitespace trim
<%if [enlist<kinds>!match[other]] %>
<div class="trpg-kind-switches">
<$list filter="Player Person Organisation Location Item Quest" variable="trpg-hub">
<$transclude $variable="trpg.kindswitch" hub=<<trpg-hub>> kinds=<<kinds>> state=<<state>>
	second={{{ [<trpg-hub>match[Person]then{Deity!!color}] [<trpg-hub>match[Quest]then[var(--trpg-rumour, #9aa1aa)]] }}}/>
</$list>
</div>
<%endif%>
\end

<!-- Language system (modules/language.js): translation of a key, display name of a title,
     plural of a type. Missing keys fall back to en-GB, then to the key/title itself. -->
\function trpg.t(key) [<key>trpgtranslate[]]
\function trpg.title(title) [<title>trpgtitle[]]
\function trpg.plural(type) [<type>addprefix[Plural/]trpgtranslate[]]

<!-- Date output through the calendar engine (filters/date.js). Procedures with filtered
     attributes, so that they recompute when the language or the calendar data changes. -->

<!-- Short form of a date field or of one of its sections, with the era -->
\procedure dateformat(date,section)
<$text text={{{ [<date>dateformat:era<section>] }}}/>
\end

\procedure dateadd(date,days)
<$text text={{{ [<date>dateadd<days>] }}}/>
\end

\procedure datediff(from,to)
<$text text={{{ [<from>datediff<to>] }}}/>
\end

<!-- Rules terms in the display language of their domain (modules/rules.js, filters/rules.js):
     <<unit "228 cm">>, <<unit "60 ft" kind:"range">>, <<dice "4d6">>, <<damage "1d8 slashing">>,
     <<term wis variant:"save">>, <<term frightened value:2>>. Filtered attributes, so that they recompute when
     the rules language changes. What is not understood shows unchanged; the hint stands below
     the title (trpgrulecheck). -->
\procedure unit(value,kind)
<$text text={{{ [<value>trpgunit<kind>] }}}/>
\end

\procedure dice(value)
<$text text={{{ [<value>trpgdice[]] }}}/>
\end

\procedure damage(value)
<$text text={{{ [<value>trpgdamage[]] }}}/>
\end

\procedure term(id,variant,value)
<$text text={{{ [<id>trpgterm<variant>,<value>] }}}/>
\end

<!-- Locations linked in a section of the body of the current tiddler (0 = before the first
     <<date>>), without those the active view does not see; as pills, nothing if none. A
     <<spotlink>> in the section gives a pill "Spot (Location)" that jumps to the spot. -->
\procedure trpg.places(section)
\whitespace trim
<$let trpg-places={{{ [<currentTiddler>sectionlinks<section>tag[Location]] :filter[trpg.visible[]] +[sort[]format:titlelist[]join[ ]] }}}
	trpg-spotrefs={{{ [<currentTiddler>sectionspots<section>] :filter[jsonget[place]trpg.visible[]] +[format:titlelist[]join[ ]] }}}>
<%if [enlist<trpg-places>] [enlist<trpg-spotrefs>] +[first[]] %>
<div class="trpg-places">
<$list filter="[enlist<trpg-places>]" variable="trpg-place">
<$link to=<<trpg-place>>><$transclude $variable="tag-pill" tag=<<trpg-place>>/></$link>
</$list>
<$list filter="[enlist<trpg-spotrefs>]" variable="trpg-ref">
<$transclude $variable="trpg.spotpill" place={{{ [<trpg-ref>jsonget[place]] }}} spot={{{ [<trpg-ref>jsonget[spot]] }}}/>
</$list>
</div>
<%endif%>
</$let>
\end

<!-- Pill of a <<spotlink>> in a section: "Spot (Location)" in the colour of the location;
     opens the tiddler the spot is joined to, or the location at the spot in its map tab -->
\procedure trpg.spotpill(place,spot)
\whitespace trim
<$let trpg-colour={{{ [<place>] :cascade[all[shadows+tiddlers]tag[$:/tags/TiddlerColourFilter]!is[draft]get[text]] }}}
	trpg-label={{{ [<place>spots[]match<spot>then<spot>addsuffix[ (]addsuffix<place>addsuffix[)]] ~[<place>] }}}>
<$transclude $variable="trpg.spotjump" place=<<place>> spot=<<spot>>>
<span class="tc-tag-label trpg-spot-pill" style={{{ [<trpg-colour>addprefix[--trpg-pill:]] }}}><$text text=<<trpg-label>>/></span>
</$transclude>
\end

<!-- Link around the slot content to a spot: the tiddler the spot is joined to; else the
     location, switched to its map tab and scrolled to the spot (widgets/jump.js); else the
     location alone (missing spot) -->
\procedure trpg.spotjump(place,spot)
\whitespace trim
<$let trpg-joined={{{ [<spot>spottarget[]] }}}>
<%if [<trpg-joined>!is[blank]] %>
<$link to=<<trpg-joined>>><$slot $name="ts-raw"/></$link>
<%elseif [<place>spots[]match<spot>] %>
<$trpg-jump anchor={{{ [<spot>spotanchor[]] }}} tabstate={{{ [<place>addprefix[$:/state/tiddlyrpg-core/location-tab/]] }}} tab="map"><$link to=<<place>>><$slot $name="ts-raw"/></$link></$trpg-jump>
<%else%>
<$link to=<<place>>><$slot $name="ts-raw"/></$link>
<%endif%>
</$let>
\end

<!-- Date line below the tags of every tiddler with dates, right-aligned: an event shows the span
     of its date field ("????" with the era if it has none), every other type its years of
     existence (mode "year", nothing without dates) - of its last phase only, after a death and
     a return ("./1351, 1355" shows 1355). With the hint on a date that cannot be read. -->
\procedure trpg.dateline(mode)
\whitespace trim
<%if [<mode>match[year]] %>
<$let trpg-text={{{ [<currentTiddler>get[date]dateformat:year,era,last[]] }}}>
<%if [<trpg-text>!is[blank]] %><div class="trpg-dateline"><$text text=<<trpg-text>>/></div><%endif%>
</$let>
<%else%>
<div class="trpg-dateline"><$text text={{{ [<currentTiddler>visibledate[]dateformat:era[]!is[blank]] ~[calendar[era]!is[blank]addprefix[???? ]] ~[[????]] }}}/></div>
<%endif%>
<<trpg.datecheck>>
\end

<!-- Hint for the editor if the date field of the current tiddler cannot be read or names a
     day the calendar does not have; not in the published (read-only) copy -->
\procedure trpg.datecheck()
\whitespace trim
<$list filter="[<currentTiddler>get[date]datecheck[]] :filter[[yes]!match{$:/status/IsReadOnly}]" variable="trpg-raw">
<div class="trpg-date-invalid"><$text text={{{ [[Date/Invalid]trpgtranslate[]] }}}/> <code><$text text=<<trpg-raw>>/></code></div>
</$list>
\end

<!-- A dated section in the body: <<date>> is the next section of the date field (the first
     is 1), <<date 3>> section 3, <<date label:"Caption">> / <<date 3 label:"Caption">> with a caption.
     Draws the rule before it (not at the very start of the body), the date, the caption and
     the locations of the section (its frame: styles/sections). widgets/date.js finds out which
     section it is. Without any date in the field the heading is "????" (with the era). The heading is the jump mark
     "date-<n>" (data-trpg-anchor, modules/anchor-jump.js) - not at the very start of the body:
     there a jump would only hide the title, the plain navigation already shows the section. The
     caption is inline wikitext: <<date label:"Fight at <<unit '30 ft'>>">> (other quotes inside). -->
\procedure date(section,label)
\whitespace trim
<$trpg-date section=<<section>> label=<<label>>>

<%if [<trpg-section>is[blank]] %>
<div class="trpg-date-invalid"><$text text={{{ [[Date/SectionHint]trpgtranslate[]] }}}/></div>
<%else%>
<$let trpg-dated={{{ [<currentTiddler>get[date]trim[]] }}}
	trpg-text={{{ [<currentTiddler>get[date]dateformat:era<trpg-section>!is[blank]] ~[<trpg-dated>is[blank]then[????]] }}}
	trpg-era={{{ [<trpg-dated>is[blank]] :then[calendar[era]!is[blank]addprefix[ ]] }}}
	trpg-anchor={{{ [<trpg-first>!match[yes]] :then[<trpg-section>addprefix[date-]] }}}>

<%if [<trpg-first>!match[yes]] %><hr class="trpg-date-rule"/><%endif%>
<%if [<trpg-text>is[blank]] %>
<div class="trpg-date-invalid" data-trpg-anchor=<<trpg-anchor>>><$text text={{{ [[Date/SectionMissing]trpgtranslate[]search-replace[$n$],<trpg-section>] }}}/></div>
<%else%>
<div class="trpg-date-heading" data-trpg-anchor=<<trpg-anchor>>><$text text=<<trpg-text>>/><$text text=<<trpg-era>>/><%if [<trpg-label>!is[blank]] %><span class="trpg-date-label"><$text text=" – "/><$transclude $variable="trpg-label" $mode="inline"/></span><%endif%></div>
<%endif%>
<$transclude $variable="trpg.places" section=<<trpg-section>>/>

</$let>
<%endif%>

</$trpg-date>
\end

<!-- A lock: <<secret "Theren" "Actia">> locks the section it stands at (modules/sections.js),
     <$secret for="...">...</$secret> what it encloses (widgets/sections.js). Draws nothing itself:
     the section shows the marker for whom it is. -->
\procedure secret()
\end

<!-- A spot of a location (modules/spots.js): <<spot "Name">>, <<spot "Tempel von [[Chauntea]]">>,
     <<spot "Name" tiddler:"Tiddler">>, <<spot "Name" image:"a.jpg, b.jpg" map:"c.jpg">>. Draws
     the heading of the spot with the jump mark "spot-<name>". Joined to a tiddler (tiddler:, or
     a tiddler with the plain name), the heading links to it and the tiddler shows
     its own images; otherwise the name is rendered as wikitext, links in it stay links, and its
     images (images/location/) and maps (images/map/) follow below the heading (trpg.images,
     not in the tooltip of the map: trpg-spot-media="no"). Its text and its place on the map
     come from the parse tree, not from this procedure. -->
\procedure spot(name,tiddler,image,map)
\whitespace trim
<$let trpg-target={{{ [<name>spottarget<tiddler>] }}}>
<h3 class="trpg-spot" data-trpg-anchor={{{ [<name>spotanchor[]] }}}>
<%if [<trpg-target>!is[blank]] %>
<$link to=<<trpg-target>>><$text text={{{ [<name>spotplain[]] }}}/></$link>
<%else%>
<$transclude $variable="name" $mode="inline"/>
<%endif%>
</h3>
<%if [<trpg-target>is[blank]then[yes]] :filter[<trpg-spot-media>!match[no]then[yes]] %>
<$transclude $variable="trpg.images"
	entries="[<image>imagelist[location]] [<map>imagelist[map]]"
	state={{{ [<name>spotplain[]addprefix[/]addprefix<currentTiddler>addprefix[$:/state/tiddlyrpg-core/spot-tab/]] }}}/>
<%endif%>
</$let>
\end

<!-- A quest marker in an event (modules/sections.js, modules/quests.js): <<quest "Name">> at the
     start of a paragraph, <<quest "Name" status:"complete">> where the quest ends,
     <$quest name="Name">...</$quest> around what it marks. Draws the label of the marker: quest
     (a tiddler tagged Quest) or rumour, the name as a link, the status where it is set. What
     it marks and its frame come from the parse tree (trpg-nest, the block), not from this
     procedure. Nothing for a quest the view does not see. -->
\procedure quest(name,status)
\whitespace trim
<%if [<name>!is[blank]trpg.visible[]] %>
<$let trpg-real={{{ [<name>questreal[]then[yes]] }}}>
<span class={{{ [<trpg-real>match[yes]then[trpg-quest-label trpg-quest-real]else[trpg-quest-label trpg-quest-rumour]] }}}>
<span class="trpg-quest-kind"><$text text={{{ [<trpg-real>match[yes]then[Quest/Kind/Quest]else[Quest/Kind/Rumour]trpgtranslate[]] }}}/></span>
<$link to=<<name>>><$text text=<<name>>/></$link>
<%if [<status>match[complete]] [<status>match[failed]] +[limit[1]] %>
<span class="trpg-quest-status"><$text text={{{ [<status>addprefix[Quest/Status/]trpgtranslate[]] }}}/></span>
<%endif%>
</span>
</$let>
<%endif%>
\end

<!-- Images or maps of a tiddler or spot (filters/images.js): <entries> is a filter giving the
     entries as JSON {id, label, path}. One shows on its own, two or more as tabs labelled with
     the file names (tab state <state>). A click on a map opens the file (trpg.image). -->
\procedure trpg.images(entries,state)
\whitespace trim
<$let trpg-n={{{ [subfilter<entries>count[]] }}}>
<%if [<trpg-n>match[1]] %>
<$list filter="[subfilter<entries>]" variable="trpg-entry"><$transclude $variable="trpg.image" entry=<<trpg-entry>>/></$list>
<%elseif [<trpg-n>compare:number:gt[1]] %>
<$let trpg-ids={{{ [subfilter<entries>jsonget[id]format:titlelist[]join[ ]] }}}>
<$transclude $tiddler="$:/plugins/flibbles/graph/ui/grouped-tabs"
	tabsList=<<trpg-ids>>
	default={{{ [enlist<trpg-ids>first[]] }}}
	explicitState=<<state>>
	class="trpg-image-tabs">
<$fill $name=button><$text text={{{ [subfilter<entries>] :filter[jsonget[id]match<currentTab>] +[first[]jsonget[label]] }}}/></$fill>
<$fill $name=body><$list filter="[subfilter<entries>] :filter[jsonget[id]match<currentTab>] +[first[]]" variable="trpg-entry"><$transclude $variable="trpg.image" entry=<<trpg-entry>>/></$list></$fill>
</$transclude>
</$let>
<%endif%>
</$let>
\end

<!-- One image or map, scaled to the width; a click on a map (images/map/) opens the file -->
\procedure trpg.image(entry)
\whitespace trim
<$let trpg-path={{{ [<entry>jsonget[path]] }}}>
<div class="trpg-image">
<%if [<trpg-path>prefix[images/map/]] %>
<a href={{{ [<trpg-path>encodeuri[]] }}} target="_blank" rel="noopener noreferrer"><$image source=<<trpg-path>>/></a>
<%else%>
<$image source=<<trpg-path>>/>
<%endif%>
</div>
</$let>
\end

<!-- Images in a text or of a tiddler (filters/images.js): <<image>> the field image of the
     current tiddler (the view template shows it), <<image "a.png, b.png">> files in the image
     folder of its type, folder:"event" in another folder of images/. One shows on its own, two
     or more as tabs named after the files; every call has a tab state of its own. -->
\procedure image(files,folder)
\whitespace trim
<%if [<files>!is[blank]] %>
<$let trpg-folder={{{ [<folder>!is[blank]] ~[<currentTiddler>imagefolder[]] }}}>
<$transclude $variable="trpg.images"
	entries="[<files>imagelist<trpg-folder>]"
	state={{{ [<files>addprefix[/]addprefix<currentTiddler>addprefix[$:/state/tiddlyrpg-core/image-tab/]] }}}/>
</$let>
<%else%>
<$transclude $variable="trpg.images"
	entries="[<currentTiddler>imagetabs[]]"
	state={{{ [<currentTiddler>addprefix[$:/state/tiddlyrpg-core/image-tab/]] }}}/>
<%endif%>
\end

<!-- A reference to a spot: <<spotlink "Baile" "Schloss Baile">> or
     <<spotlink "Miehall" "[[Trunkenen Eulenbären|Zum Trunkenen Eulenbären]]">> (text before
     "|", spot after it). A spot joined to a tiddler opens that tiddler, any other spot the
     location at the spot; a spot or location that does not exist gives a hint for the editor
     (not in the published copy). The section pills (trpg.places) show it as well. -->
\procedure spotlink(location,spot)
\whitespace trim
<$let trpg-spot={{{ [<spot>spotref:spot[]] }}}
	trpg-text={{{ [<spot>spotref:text[]] }}}>
<$transclude $variable="trpg.spotjump" place=<<location>> spot=<<trpg-spot>>><$text text=<<trpg-text>>/></$transclude>
<$transclude $variable="trpg.spotcheck" place=<<location>> spot=<<trpg-spot>>/>
</$let>
\end

<!-- Hint for the editor on a <<spotlink>> whose location or spot does not exist; not in the
     published (read-only) copy -->
\procedure trpg.spotcheck(place,spot)
\whitespace trim
<%if [{$:/status/IsReadOnly}!match[yes]] %>
<%if [<place>!is[tiddler]!is[shadow]] %>
<span class="trpg-date-invalid"> <$text text={{{ [[Spot/PlaceMissing]trpgtranslate[]search-replace[$place$],<place>] }}}/></span>
<%elseif [<spot>spottarget[]] [<place>spots[]match<spot>] +[count[]match[0]] %>
<span class="trpg-date-invalid"> <$text text={{{ [[Spot/Missing]trpgtranslate[]search-replace[$spot$],<spot>search-replace[$place$],<place>] }}}/></span>
<%endif%>
<%endif%>
\end

<!-- Where a tiddler is, as a path below its title (filter locationgroups): "Materielle Ebene ›
     Andu Falas › Königreich von Vandalia" for a location; for persons, organisations and the
     like the places of their field location and the locations they lead (field leader), one
     line per parent path, the places of a line comma separated ("… › Königreich von Vandalia ›
     Cair Di, Golwyn"); with the hints of locationcheck (not in the published copy). What the
     view does not see is left out: a place it does not see, and a line if no place of it is
     left - else the line would tell where it lies. -->
\procedure trpg.locationpath()
\whitespace trim
<$list filter="[<currentTiddler>locationgroups[]]" variable="trpg-group">
<$let trpg-path={{{ [<trpg-group>jsonget[path]] }}}
	trpg-places={{{ [<trpg-group>jsonget[places]] }}}
	trpg-paths={{{ [enlist<trpg-path>count[]] }}}
	trpg-count={{{ [enlist<trpg-places>count[]] }}}>
<div class="trpg-location-path"><$list filter="[enlist<trpg-path>]" variable="trpg-step" counter="trpg-n"><%if [<trpg-n-first>!match[yes]] %><span class="trpg-location-path-sep">›</span><%endif%><$transclude $variable="trpg.link" title=<<trpg-step>>/></$list><%if [<trpg-paths>compare:number:gt[0]] :filter[<trpg-count>compare:number:gt[0]] %><span class="trpg-location-path-sep">›</span><%endif%><$list filter="[enlist<trpg-places>]" variable="trpg-step" counter="trpg-n"><%if [<trpg-n-first>!match[yes]] %><span class="trpg-location-path-sep trpg-location-path-comma">,</span><%endif%><$transclude $variable="trpg.link" title=<<trpg-step>>/></$list></div>
</$let>
</$list>
<$list filter="[<currentTiddler>locationcheck[]] :filter[[yes]!match{$:/status/IsReadOnly}]" variable="trpg-key">
<div class="trpg-date-invalid"><$text text={{{ [<trpg-key>trpgtranslate[]] }}}/></div>
</$list>
\end

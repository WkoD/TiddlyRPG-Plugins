/* Deceased/destroyed: class trpg-dead (config/class-dead, function trpg.dead). Grey as a mix of
   palette colours - exactly #dddddd in the Vanilla palette, correspondingly dark in dark
   palettes - for a type without a colour; a type with a colour stripes grey and its colour
   (styles/border, tag-pill-stripes in functions). */
.trpg-dead {
background-color: color-mix(in srgb, var(--tpc-muted-foreground) 50%, var(--tpc-tiddler-background));
}

/* A link to a deceased/destroyed tiddler (procedure trpg.link): struck through, on hover
   underlined as well - the core sets text-decoration on a.tc-tiddlylink:hover. */
a.tc-tiddlylink.trpg-dead-link {
text-decoration: line-through;
}

a.tc-tiddlylink.trpg-dead-link:hover {
text-decoration: line-through underline;
}

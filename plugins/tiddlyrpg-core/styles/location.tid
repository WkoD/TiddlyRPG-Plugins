/* Locations: the path below the title (procedure trpg.locationpath), the pill of a <<spotlink>>
   in a section (trpg.spotpill), the spots of a location (procedure spot, tab "Map"), the map
   with its buttons (viewtemplates/location/map) and the relations block (its switches by kind,
   the group headings, the tree). Palette colours via --tpc-*. */
.trpg-location-path {
	color: var(--tpc-muted-foreground, #888);
	font-size: 0.85em;
	margin: -0.3em 0 0.4em;
}
.trpg-location-path a.tc-tiddlylink {
	font-weight: normal;
}
.trpg-location-path-sep {
	margin: 0 0.35em;
}
.trpg-location-path-comma {
	margin: 0 0.35em 0 0;
}
/* The switches above the relations block (viewtemplates/relations): one per kind, a point in the
   colour of its hub; switched off it fades. */
.trpg-kind-switches {
	display: flex;
	flex-wrap: wrap;
	gap: 4px 6px;
	margin: 0.3em 0 0.5em;
}
.trpg-kind-switch {
	display: inline-flex;
	align-items: center;
	gap: 5px;
	padding: 0 9px;
	border: 1px solid var(--trpg-kind);
	border-radius: 999px;
	background: color-mix(in srgb, var(--trpg-kind) 18%, var(--tpc-tiddler-background, #fff));
	color: var(--tpc-foreground, #333);
	font-size: 0.85em;
	line-height: 1.6;
	cursor: pointer;
}
.trpg-kind-switch::before {
	content: "";
	width: 0.6em;
	height: 0.6em;
	border-radius: 50%;
	background: var(--trpg-kind);
}
.trpg-kind-switch.trpg-off {
	border-color: var(--tpc-tiddler-border, #ccc);
	background: transparent;
	color: var(--tpc-muted-foreground, #888);
}
.trpg-kind-switch.trpg-off::before {
	background: transparent;
	box-shadow: inset 0 0 0 1.5px var(--trpg-kind);
}
/* A switch of two kinds with colours of their own (persons and deities, quests and rumours):
   both colours split at 45°, the first on the left (--trpg-kind), the second on the right
   (--trpg-kind2) */
.trpg-kind-switch.trpg-kind-split {
	border-color: transparent;
	background:
		linear-gradient(45deg,
			color-mix(in srgb, var(--trpg-kind) 18%, var(--tpc-tiddler-background, #fff)) 50%,
			color-mix(in srgb, var(--trpg-kind2) 22%, var(--tpc-tiddler-background, #fff)) 50%) padding-box,
		linear-gradient(45deg, var(--trpg-kind) 50%, var(--trpg-kind2) 50%) border-box;
}
.trpg-kind-switch.trpg-kind-split::before {
	background: linear-gradient(45deg, var(--trpg-kind) 50%, var(--trpg-kind2) 50%);
}
.trpg-kind-switch.trpg-kind-split.trpg-off {
	border-color: var(--tpc-tiddler-border, #ccc);
	background: transparent;
}
.trpg-kind-switch.trpg-kind-split.trpg-off::before {
	box-shadow: none;
	background:
		radial-gradient(circle, var(--tpc-tiddler-background, #fff) 0 0.15em, transparent 0.16em),
		linear-gradient(45deg, var(--trpg-kind) 50%, var(--trpg-kind2) 50%);
}
/* Group heading of the relation list: only the first letter, a label of several words keeps
   its small letters. */
.trpg-relations-group::first-letter {
	text-transform: uppercase;
}
/* Like a tag pill (tag-pill-styles in functions): an outline in the colour of the location,
   light inside */
.tc-tag-label.trpg-spot-pill {
	display: inline-block;
	background-color: color-mix(in srgb, var(--trpg-pill) 18%, var(--tpc-background, #fff));
	box-shadow: inset 0 0 0 1px var(--trpg-pill);
	color: var(--tpc-foreground, #333);
	border-radius: 1em;
	padding: 0 0.5em;
	font-size: 0.9em;
	line-height: 1.5;
	white-space: nowrap;
}
.trpg-via {
	color: var(--tpc-muted-foreground, #888);
	font-size: 0.9em;
}
/* The tree of a location in the relation list (viewtemplates/relations/list, trpg.tree) */
details.trpg-tree > summary {
	cursor: pointer;
}
.trpg-tree-children {
	margin-left: 1.2em;
}
.trpg-spot {
	margin: 1em 0 0.3em;
}
.trpg-spots > .trpg-spot:first-child {
	margin-top: 0.5em;
}
.trpg-map .graph-canvas {
	height: 420px;
}
.trpg-map-buttons {
	display: flex;
	flex-wrap: wrap;
	gap: 4px 12px;
	margin: 0.3em 0;
	font-size: 0.9em;
}
.trpg-map-button {
	color: var(--tpc-tiddler-link-foreground, inherit);
}
.trpg-map-button-on {
	font-weight: bold;
}

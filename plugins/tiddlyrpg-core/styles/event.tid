/* Date line below the tags (procedure trpg.dateline: span of an event, years of existence of the
   other types), head of an event
   (viewtemplates/event), dated sections in the body (procedure date), location pills (procedure
   trpg.places) and hints on dates that cannot be read (trpg.datecheck). Palette colours via
   --tpc-*. */
.trpg-dateline {
	text-align: right;
	font-size: 0.85em;
	line-height: 1.3;
}
.trpg-date-heading {
	font-weight: bold;
}
.trpg-date-label {
	font-weight: normal;
}
.trpg-date-rule {
	margin: 1.2em 0 0.8em;
}
.trpg-date-heading + .trpg-places {
	margin-top: 0.2em;
}
.trpg-places {
	display: flex;
	flex-wrap: wrap;
	gap: 3px 4px;
	margin-bottom: 0.6em;
}
.trpg-places a.tc-tiddlylink {
	text-decoration: none;
}
.trpg-date-invalid {
	color: var(--tpc-alert-highlight, #b00);
	font-size: 0.85em;
}

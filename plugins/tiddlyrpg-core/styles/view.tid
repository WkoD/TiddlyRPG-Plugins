/* Views (modules/visibility.js): a coloured bar at the top of the window outside the public view
   (config/class-view adds trpg-view-<mode> to the page container) - in the colour of the Player
   hub for a player, in the alert colour for the DM -, the page control ui/view-switcher and the
   cards of the Player hub. Locked tiddlers and sections: styles/sections. */
.tc-page-container.trpg-view-player::before,
.tc-page-container.trpg-view-dm::before {
	content: "";
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	height: 4px;
	z-index: 1000;
	pointer-events: none;
}
.tc-page-container.trpg-view-player::before {
	background: {{Player!!color}};
}
.tc-page-container.trpg-view-dm::before {
	background: <<colour alert-highlight>>;
}
.trpg-view-button .trpg-view-current {
	margin-left: 0.3em;
	font-size: 0.9em;
	vertical-align: middle;
}
.trpg-view-dm .trpg-view-button {
	fill: <<colour alert-highlight>>;
	color: <<colour alert-highlight>>;
}
.trpg-view-dropdown .trpg-view-check {
	display: inline-block;
	width: 1.4em;
}
.trpg-view-dropdown .trpg-view-check svg {
	width: 0.9em;
	height: 0.9em;
	vertical-align: middle;
}
.trpg-players {
	display: flex;
	flex-wrap: wrap;
	gap: 0.8em;
	margin: 0.5em 0 1em 0;
}
/* A card: a broad band in the colour of the Player hub on top, on the background of the tiddler,
   the name in a dark shade of that colour (like the labels of the block of values); 12.6em, so
   two fit beside the list of the hubs on the hub Campaign. The level below them likewise. */
a.trpg-player-card {
	display: flex;
	flex-direction: column;
	align-items: center;
	box-sizing: border-box;
	width: 12.6em;
	padding: 0.8em 0.5em;
	border: 1px solid {{Player!!color}};
	border-top: 5px solid {{Player!!color}};
	border-radius: 6px;
	background: <<colour tiddler-background>>;
	box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
	text-decoration: none;
	color: <<colour foreground>>;
	text-align: center;
}
a.trpg-player-card .trpg-player-name,
.trpg-player-level b {
	color: color-mix(in srgb, {{Player!!color}} 70%, <<colour foreground>>);
}
a.trpg-player-card:hover {
	background: <<colour tiddler-editor-background>>;
	text-decoration: none;
}
.trpg-player-portrait img {
	width: 9em;
	height: 9em;
	object-fit: cover;
	object-position: top;
	border-radius: 4px;
}
.trpg-player-name {
	font-weight: bold;
	margin-top: 0.3em;
}
.trpg-player-of {
	font-size: 0.85em;
	color: <<colour muted-foreground>>;
}
a.trpg-player-card.trpg-dead {
	border-style: dashed;
	border-top-style: solid;
	background: color-mix(in srgb, <<colour foreground>> 4%, <<colour tiddler-background>>);
	opacity: 0.7;
}

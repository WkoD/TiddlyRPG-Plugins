/* Rules: the tables of the hubs Ruleset and CampaignSetting (modules/rules.js table()), the table of the rules language in the settings tab, the converter of the hub
   Currency. Palette colours via --tpc-*. */
.trpg-rules-hub td,
.trpg-rules-hub th,
.trpg-rules-table td,
.trpg-rules-table th {
	vertical-align: top;
}
.trpg-rules-hub small {
	font-weight: normal;
	color: var(--tpc-muted-foreground, #888);
}
.trpg-rules-hub s {
	color: var(--tpc-muted-foreground, #888);
}
.trpg-currency-converter input {
	width: 12em;
}
/* The choice of ruleset and campaign setting (ui/settings-ruleset): the button fills the row of
   the chooser like the link of the core theme switcher, so a click anywhere in it chooses */
.trpg-chooser .tc-chooser-item > button {
	display: block;
	width: 100%;
	padding: 0;
	text-align: start;
	color: inherit;
	font: inherit;
	line-height: inherit;
}
.trpg-chooser .tc-chosen > button {
	cursor: default;
}
.trpg-chooser .tc-chosen > button:before {
	margin-inline-start: -10px;
	position: relative;
	content: "» ";
}
.trpg-chooser .tc-chooser-item > button[disabled] {
	cursor: default;
}
/* A note below the choice: an own calendar or currency of the wiki */
.trpg-settings-note {
	margin-top: 0.5em;
	color: var(--tpc-muted-foreground, #666);
}

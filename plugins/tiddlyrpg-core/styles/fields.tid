title: $:/plugins/tiddlyrpg-core/styles/fields
type: text/css

/* The values of the fields of the rules (viewtemplates/fields): the header line in italics, the
   groups set apart by a fine line in the colour of the type (--trpg-type, set by the template),
   a row group as a compact table, lists as small pills. Palette colours via --tpc-*, so light
   and dark palettes both fit. */
.trpg-fields {
	--trpg-type-line: color-mix(in srgb, var(--trpg-type, var(--tpc-muted-foreground, #888)) 55%, transparent);
	margin: 0.6em 0;
	font-size: 0.95em;
}
.trpg-fields-summary {
	font-style: italic;
	color: var(--tpc-muted-foreground, #666);
	margin-bottom: 0.3em;
}
.trpg-fields-list {
	display: grid;
	grid-template-columns: max-content 1fr;
	column-gap: 0.8em;
	row-gap: 0.15em;
	align-items: baseline;
	margin: 0.3em 0;
}
.trpg-fields-list dt,
.trpg-fields-list dd {
	margin: 0;
	padding: 0;
}
.trpg-fields-list dt {
	font-weight: bold;
}
.trpg-fields-group {
	border-top: 1px solid var(--trpg-type-line);
	margin-top: 0.4em;
	padding-top: 0.3em;
}
.trpg-fields-group-label {
	font-size: 0.8em;
	font-weight: bold;
	text-transform: uppercase;
	letter-spacing: 0.04em;
	color: var(--trpg-type, var(--tpc-muted-foreground, #666));
}
table.trpg-fields-row {
	border-collapse: collapse;
	border: none;
	margin: 0.2em 0;
	width: auto;
}
.trpg-fields-row th,
.trpg-fields-row td {
	border: none;
	padding: 0.05em 0.9em 0.05em 0;
	text-align: start;
	background: none;
}
.trpg-fields-row th {
	font-size: 0.85em;
	color: var(--tpc-muted-foreground, #666);
}
.trpg-fields-pills {
	display: inline-flex;
	flex-wrap: wrap;
	gap: 0.25em;
}
.trpg-fields-pill {
	padding: 0 0.5em;
	border-radius: 0.8em;
	font-size: 0.9em;
	background-color: color-mix(in srgb, var(--trpg-type, var(--tpc-muted-foreground, #888)) 15%, var(--tpc-tiddler-background, #fff));
	box-shadow: inset 0 0 0 1px var(--trpg-type-line);
}

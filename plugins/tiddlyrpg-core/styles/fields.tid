/* The block of values (viewtemplates/fields), like the stat block of a rulebook: a strong rule in
   the colour of the type (--trpg-type, set by the template) above and below, the header line in
   italics, the sections parted by a rule that fades out, labels bold in a dark shade of the type
   colour, a row section (the abilities) as centred cells. Palette colours via --tpc-*, so light
   and dark palettes both fit. */
.trpg-fields {
	--trpg-type-c: var(--trpg-type, var(--tpc-muted-foreground, #888));
	--trpg-type-ink: color-mix(in srgb, var(--trpg-type-c) 55%, var(--tpc-foreground, #222));
	border-top: 3px solid var(--trpg-type-c);
	border-bottom: 3px solid var(--trpg-type-c);
	margin: 0.8em 0;
	padding: 0.35em 0 0.25em;
}
.trpg-fields-summary {
	font-style: italic;
	margin-bottom: 0.2em;
}
.trpg-fields-section {
	padding: 0.3em 0;
}
.trpg-fields-summary + .trpg-fields-section,
.trpg-fields-section + .trpg-fields-section {
	border-top: 2px solid transparent;
	border-image: linear-gradient(to right, var(--trpg-type-c), transparent) 1;
}
.trpg-fields-lines {
	margin: 0.05em 0;
}
.trpg-fields-label {
	font-weight: bold;
	color: var(--trpg-type-ink);
}
.trpg-fields-row {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(4.5em, 1fr));
	text-align: center;
}
.trpg-fields-cell .trpg-fields-label {
	display: block;
	font-size: 0.85em;
}
/* Values secret-fields locks, for those who see them: marked in the alert colour like a locked
   section - a line on top, a line or cell with a bar on its left, the whole block with a broad
   one */
.trpg-fields-locked {
	box-shadow: inset 3px 0 0 var(--tpc-alert-highlight, #b00);
	background: color-mix(in srgb, var(--tpc-alert-highlight, #b00) 7%, transparent);
	padding-inline-start: 0.5em;
}
.trpg-fields.trpg-fields-locked {
	box-shadow: inset 4px 0 0 var(--tpc-alert-highlight, #b00);
	padding-inline-start: 0.7em;
}
.trpg-fields-lockmark {
	margin-bottom: 0.3em;
	padding: 1px 0.6em;
	border-radius: 0 5px 5px 0;
	background: var(--tpc-alert-highlight, #b00);
	color: var(--tpc-tiddler-background, #fff);
	font-size: 0.8em;
}

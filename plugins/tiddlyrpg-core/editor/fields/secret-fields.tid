title: $:/plugins/tiddlyrpg-core/editor/fields/secret-fields
type: text/vnd.tiddlywiki

<!-- Editor of secret-fields, the lock of the values of the rules (modules/visibility.js): a pill
     "all" (the whole block and the price) and a pill per field of the rules the draft has
     (trpglockfields), in the alert colour like a lock. "all" stands alone; taking out the last
     lock takes out the field - an empty secret-fields would lock all (trpglocktoggle).
     Variables: currentTiddler (the draft), currentField. -->
\procedure trpg.lockpill(id,label)
\whitespace trim
<$let trpg-on={{{ [<currentTiddler>trpglockon<id>then[yes]else[no]] }}}
	trpg-next={{{ [<currentTiddler>trpglocktoggle<id>] }}}>
<$button class={{{ [[tc-btn-invisible trpg-pick-pill trpg-choice]] [<trpg-on>match[no]then[trpg-off]] +[join[ ]] }}} style="--trpg-kind:var(--tpc-alert-highlight, #b00);" aria-pressed={{{ [<trpg-on>match[yes]then[true]else[false]] }}}>
<%if [<trpg-next>is[blank]] %>
<$action-deletefield $tiddler=<<currentTiddler>> $field=<<currentField>>/>
<%else%>
<$action-setfield $tiddler=<<currentTiddler>> $field=<<currentField>> $value=<<trpg-next>>/>
<%endif%>
<$text text=<<label>>/>
</$button>
</$let>
\end

\whitespace trim
<span class="trpg-pills">
<$transclude $variable="trpg.lockpill" id="all" label={{{ [[Editor/Field/LockAll]trpgtranslate[]] }}}/>
<$list filter="[<currentTiddler>trpglockfields[]]" variable="trpg-field">
<$transclude $variable="trpg.lockpill" id=<<trpg-field>> label={{{ [<currentTiddler>trpgformlabel<trpg-field>] }}}/>
</$list>
</span>

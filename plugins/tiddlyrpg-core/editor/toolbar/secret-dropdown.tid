title: $:/plugins/tiddlyrpg-core/editor/toolbar/secret-dropdown
type: text/vnd.tiddlywiki

<!-- Dropdown of the button Lock (editor/toolbar/secret): whom the lock is for - the player
     characters the view sees as pills to choose (active first, then former ones), or the DM only.
     Without a lock at the cursor Insert sets it (modules/editor.js: <<secret>> before the marker
     of the section, else <$secret> around the paragraph or the selection); at a lock - also a
     block inside a paragraph, also with a selection in it - Change and Remove. -->
\whitespace trim
<$let trpg-input=<<trpg.editor-input>>
	trpg-form=<<trpg.editor-form>>
	trpg-probe=<<trpg.editor-probe>>>
<div class="trpg-editor-dropdown">
<div class="trpg-editor-head"><$text text={{{ [<trpg-form>!is[blank]then[Editor/Secret/Change]else[Editor/Secret/Insert]trpgtranslate[]] }}}/></div>
<div class="trpg-pills">
<$transclude $variable="trpg.choicepill" tiddler=<<trpg-input>> field="dm" value="yes" label={{{ [[Editor/Secret/DM]trpgtranslate[]] }}} style="--trpg-kind:var(--tpc-alert-highlight, #b00);"/>
</div>
<%if [<trpg-input>get[dm]match[yes]] %>
<%else%>
<$transclude $variable="trpg.charpills" tiddler=<<trpg-input>> field="names"/>
<%endif%>
<$let trpg-names={{{ [<trpg-input>get[names]] }}}
	trpg-dm={{{ [<trpg-input>get[dm]] }}}
	trpg-none={{{ [<trpg-dm>!match[yes]] :filter[<trpg-names>enlist-input[]count[]match[0]] +[then[yes]else[no]] }}}>
<div class="trpg-editor-actions">
<%if [<trpg-form>is[blank]] %>
<span class="trpg-editor-hint"><$text text={{{ [<trpg-probe>jsonget[selection]match[true]then[Editor/Where/Around]else[Editor/Secret/Where]trpgtranslate[]] }}}/></span>
<$button class="trpg-do" disabled=<<trpg-none>>>
<$action-sendmessage $message="tm-edit-text-operation" $param="trpg-edit" kind="secret" op="insert" names=<<trpg-names>> dm=<<trpg-dm>>/>
<$action-deletetiddler $tiddler=<<dropdown-state>>/>
<$text text={{{ [[Editor/Insert]trpgtranslate[]] }}}/>
</$button>
<%else%>
<$button class="tc-btn-invisible trpg-remove">
<$action-sendmessage $message="tm-edit-text-operation" $param="trpg-edit" kind="secret" op="remove"/>
<$action-deletetiddler $tiddler=<<dropdown-state>>/>
<$text text={{{ [[Editor/Remove]trpgtranslate[]] }}}/>
</$button>
<$button class="trpg-do" disabled=<<trpg-none>>>
<$action-sendmessage $message="tm-edit-text-operation" $param="trpg-edit" kind="secret" op="change" names=<<trpg-names>> dm=<<trpg-dm>>/>
<$action-deletetiddler $tiddler=<<dropdown-state>>/>
<$text text={{{ [[Editor/Change]trpgtranslate[]] }}}/>
</$button>
<%endif%>
</div>
</$let>
</div>
</$let>

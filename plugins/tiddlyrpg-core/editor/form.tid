<!-- The form below the text in the editor (modules/form.js), in the controls of the editor
     (editor/procedures): the fields the type expects and every field of the form the draft has,
     labelled (trpgformlabel: Field/<field>, a field of the rules by its schema), each with its editor (trpgfieldeditor: editor/fields/*). An empty
     field is not saved: its label is in italics; × takes a field out (its value and the place in the
     form). "More fields" offers the fields of the type as pills (trpgformoffered). An item gets
     its categories as pills to choose (tag $:/tags/tiddlyrpg/ItemKind), one at most: another
     replaces it, a second click takes it out. A draft without a type tag
     gets the types as pills instead. Below the fields the messages of the checks for the draft
     with their fixes (procedure trpg.formchecks). Not for system tiddlers, hubs (tag Index) or
     what is no wikitext. -->
\procedure trpg.formmore()
\whitespace trim
<$list filter="[<currentTiddler>trpgformoffered[]] +[limit[1]]" variable="ignore">
<div class="trpg-form-row">
<span class="trpg-form-label"><$text text={{{ [[Editor/Form/More]trpgtranslate[]] }}}/></span>
<span class="trpg-pills">
<$list filter="[<currentTiddler>trpgformoffered[]]" variable="trpg-field">
<$button class="tc-btn-invisible trpg-pick-pill trpg-choice trpg-off trpg-neutral">
<$action-listops $tiddler=<<trpg-extra>> $field="list" $subfilter="[<trpg-field>]"/>
<$text text={{{ [<currentTiddler>trpgformlabel<trpg-field>addprefix[+ ]] }}}/>
</$button>
</$list>
</span>
</div>
</$list>
\end

<!-- The label of a field: in italics while empty (an empty field is not saved), × when it has a value
     or was added - a procedure of its own beside the editor, so a first value does not render the
     input anew (focus) -->
\procedure trpg.formlabel()
\whitespace trim
<$let trpg-has={{{ [<currentTiddler>has<trpg-field>then[yes]else[no]] }}}
	trpg-added={{{ [<trpg-extra>get[list]enlist-input[]match<trpg-field>then[yes]else[no]] }}}>
<span class={{{ [[trpg-form-label]] [<trpg-has>match[no]then[trpg-form-empty]] +[join[ ]] }}} title={{{ [<trpg-has>match[no]then[Editor/Form/Empty]trpgtranslate[]] }}}>
<$text text={{{ [<currentTiddler>trpgformlabel<trpg-field>] }}}/>
<%if [<trpg-has>match[yes]] [<trpg-added>match[yes]] +[limit[1]] %>
<$button class="tc-btn-invisible trpg-pill-x" tooltip={{{ [[Editor/Form/RemoveField]trpgtranslate[]] }}}>
<$action-deletefield $tiddler=<<currentTiddler>> $field=<<trpg-field>>/>
<$action-listops $tiddler=<<trpg-extra>> $field="list" $subfilter="-[<trpg-field>]"/>
×
</$button>
<%endif%>
</span>
</$let>
\end

<!-- The way back of a relation whose field lives on the other end (modules/inverse.js: owner -
     "give an item"): the chosen ones as pills with ×, held in trpg-inverse-<name> of the draft
     and written to them on saving; the picker over what may carry the field, without those that
     name the tiddler already, and the offers of the content packages (one chosen is taken at
     once, as created by the draft). -->
\procedure trpg.forminverse()
\whitespace trim
<$list filter="[<currentTiddler>trpginverse[]]" variable="trpg-name">
<$let trpg-field={{{ [<trpg-name>addprefix[trpg-inverse-]] }}}
	trpg-self={{{ [<currentTiddler>get[draft.of]] ~[<currentTiddler>] }}}>
<div class="trpg-form-row">
<span class="trpg-form-label"><$text text={{{ [<trpg-name>addprefix[FieldInverse/]trpgtranslate[]] }}}/></span>
<span class="trpg-form-value"><span class="trpg-field-relation">
<$list filter="[<currentTiddler>get<trpg-field>enlist-input[]]" variable="trpg-value">
<$let trpg-rest={{{ [<currentTiddler>get<trpg-field>enlist-input[]] -[<trpg-value>] +[format:titlelist[]join[ ]] }}}>
<span class="trpg-pick-pill" style={{{ [trpg.pillstyle<trpg-value>] }}}>
<$transclude $variable="trpg.pickname" title=<<trpg-value>>/>
<$button class="tc-btn-invisible trpg-pill-x" tooltip={{{ [[Editor/Form/Remove]trpgtranslate[]] }}}>
<%if [<trpg-rest>is[blank]] %>
<$action-deletefield $tiddler=<<currentTiddler>> $field=<<trpg-field>>/>
<%else%>
<$action-setfield $tiddler=<<currentTiddler>> $field=<<trpg-field>> $value=<<trpg-rest>>/>
<%endif%>
×
</$button>
</span>
</$let>
</$list>
<$transclude $variable="trpg.picker" id={{{ [<currentTiddler>addsuffix[/]addsuffix<trpg-field>] }}}
	candidates="[<trpg-name>trpginversesources[]] -[<currentTiddler>get<trpg-field>enlist-input[]] -[<trpg-self>relationsources<trpg-name>]"
	placeholder={{{ [[Editor/Form/Add]trpgtranslate[]] }}}
	actions="""<$action-listops $tiddler=<<currentTiddler>> $field=<<trpg-field>> $subfilter="[<trpg-pick>]"/><%if [<trpg-pick>is[missing]trpgcontentfor[]] %><$action-sendmessage $message="tm-trpg-content-take" $param={{{ [<trpg-pick>trpgcontentfor[]first[]] }}} draft=<<currentTiddler>>/><%endif%>"""/>
</span></span>
</div>
</$let>
</$list>
\end

\procedure trpg.formkinds()
\whitespace trim
<%if [<currentTiddler>trpgtypes[]] :intersection[enlist[Artifact Item Material]] +[limit[1]] %>
<div class="trpg-form-row">
<span class="trpg-form-label"><$text text={{{ [[Editor/Form/Kinds]trpgtranslate[]] }}}/></span>
<span class="trpg-pills">
<$list filter="[all[shadows+tiddlers]tag[$:/tags/tiddlyrpg/ItemKind]!is[draft]] :sort:string[trpgtitle[]]" variable="trpg-kind">
<$transclude $variable="trpg.choicepill" tiddler=<<currentTiddler>> field="tags" value=<<trpg-kind>> label={{{ [<trpg-kind>trpgtitle[]] }}} style={{{ [<trpg-kind>get[color]addprefix[--trpg-kind:]] }}} others="[all[shadows+tiddlers]tag[$:/tags/tiddlyrpg/ItemKind]]"/>
</$list>
</span>
</div>
<%endif%>
\end

<!-- The messages of the checks for the draft (trpgdraftcheck, modules/checks.js forDraft), each
     with its fix (modules/fixes.js, through tm-trpg-fix: only the draft changes), "Create" for a
     missing tiddler (a new draft) and "Do not report" (the id of the rule into trpg-noinfo or
     trpg-noerror of the draft). -->
\procedure trpg.formchecks()
\whitespace trim
<$list filter="[<currentTiddler>trpgdraftcheck[]] +[limit[1]]" variable="ignore">
<div class="trpg-form-checks">
<$list filter="[<currentTiddler>trpgdraftcheck[]]" variable="trpg-check">
<$let trpg-level={{{ [<trpg-check>jsonget[level]] }}}
	trpg-id={{{ [<trpg-check>jsonget[id]] }}}
	trpg-fix={{{ [<trpg-check>jsonget[fix]] }}}
	trpg-kind={{{ [<trpg-fix>jsonget[kind]] }}}>
<div class={{{ [<trpg-level>addprefix[trpg-check trpg-check-]] }}} title=<<trpg-id>>>
<$text text={{{ [<trpg-check>jsonget[text]] }}}/>
<span class="trpg-form-check-buttons">
<%if [<trpg-kind>match[create]] %>
<$button class="trpg-do trpg-small">
<$action-sendmessage $message="tm-new-tiddler" title={{{ [<trpg-fix>jsonget[title]] }}} tags={{{ [<trpg-fix>jsonget[type]format:titlelist[]] }}}/>
<$text text={{{ [[Editor/Fix/create]trpgtranslate[]] }}}/>
</$button>
<%elseif [<trpg-kind>!is[blank]] %>
<$button class="trpg-do trpg-small">
<$action-sendmessage $message="tm-trpg-fix" draft=<<currentTiddler>> fix=<<trpg-fix>>/>
<$text text={{{ [<trpg-kind>addprefix[Editor/Fix/]trpgtranslate[]] }}}/>
</$button>
<%endif%>
<$button class="trpg-do-2 trpg-small" tooltip={{{ [[Editor/Fix/OffHint]trpgtranslate[]] }}}>
<$action-listops $tiddler=<<currentTiddler>> $field={{{ [<trpg-level>match[hint]then[trpg-noinfo]else[trpg-noerror]] }}} $subfilter="[<trpg-id>]"/>
<$text text={{{ [[Editor/Fix/Off]trpgtranslate[]] }}}/>
</$button>
</span>
</div>
</$let>
</$list>
</div>
</$list>
\end

\whitespace trim
<%if [<currentTiddler>trpgwikitext[]!is[system]!tag[Index]] :filter[get[draft.of]is[system]then[no]else[yes]match[yes]] %>
<$let trpg-extra={{{ [<currentTiddler>addprefix[$:/state/tiddlyrpg-core/form-extra/]] }}}>
<div class="trpg-form">
<%if [<currentTiddler>trpgtypes[]count[]match[0]] %>
<div class="trpg-form-row">
<span class="trpg-form-label"><$text text={{{ [[Editor/Form/Type]trpgtranslate[]] }}}/></span>
<span class="trpg-pills">
<$list filter="[trpgtypelist[]] -[all[shadows+tiddlers]tag[$:/tags/tiddlyrpg/ItemKind]] :sort:string[trpgtitle[]]" variable="trpg-type">
<$transclude $variable="trpg.choicepill" tiddler=<<currentTiddler>> field="tags" value=<<trpg-type>> label={{{ [<trpg-type>trpgtitle[]] }}} style={{{ [<trpg-type>get[color]addprefix[--trpg-kind:]] }}}/>
</$list>
</span>
</div>
<%endif%>
<$transclude $variable="trpg.formkinds"/>
<$list filter="[<currentTiddler>trpgformfields[]]" variable="trpg-field">
<div class="trpg-form-row">
<$transclude $variable="trpg.formlabel"/>
<span class="trpg-form-value"><$let currentField=<<trpg-field>>><$transclude $tiddler={{{ [<trpg-field>trpgfieldeditor[]] ~[[$:/core/ui/EditTemplate/fieldEditor/default]] }}}/></$let></span>
</div>
</$list>
<$transclude $variable="trpg.forminverse"/>
<$transclude $variable="trpg.formmore"/>
<$transclude $variable="trpg.formchecks"/>
</div>
</$let>
<%endif%>

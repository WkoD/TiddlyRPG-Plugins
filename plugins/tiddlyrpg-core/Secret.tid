<!-- Tag of the lock: a tiddler tagged Secret is visible to the DM and to the players of the
     player characters it is tagged with (modules/visibility.js). No type hub (no tag Index, no
     colour): it must not colour or frame what it locks. Lists what the active view sees. -->
<$list filter="[tag[Secret]!is[draft]] :filter[trpg.visible[]] +[sort[title]]">
<div class="tc-menu-list-subitem">
<<trpg.link title={{!!title}}>>
<$let trpg-for={{{ [<currentTiddler>trpgcharacters[]] +[join[, ]] }}}>
<span class="trpg-secret-for"><$text text={{{ [<trpg-for>!is[blank]addprefix[ (]addsuffix[)]] }}}/></span>
</$let>
</div>
</$list>

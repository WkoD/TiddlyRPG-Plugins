<!-- Combined graph+list block: one tab list "Graph"/"List" (graph active by default) instead
     of both stacked. The type scope (multitag) is stated only here, once, instead of separately
     in the two tab content tiddlers. Tab switcher = $:/plugins/flibbles/graph/ui/grouped-tabs
     (part of tw5-graph, already a dependency). explicitState -> a tab state per tiddler
     ($:/state/tiddlyrpg-core/relations-tab/<title>, quest-relations-tab/<title> for a quest), so
     a tiddler opened the first time shows the graph; $:/state/ is neither synced nor saved.
     On top of the tab (graph and list alike) the switches by kind (procedure trpg.kindswitches,
     functions.tid) of what they can show (trpg.egonodes); state
     $:/state/tiddlyrpg-core/relations-filter/<title> (trpg.egoshown). The tiddler itself always
     shows.
     A quest or rumour has its own tabs instead (quest-graph, quest-list: its events and what its
     markers there mention, graph/templates/trpg-quest), with the same switches. -->
\procedure trpg.relationstab()
<$transclude $variable="trpg.kindswitches" kinds=<<trpg-kinds>> state=<<trpg-state>>/>
<$transclude $tiddler=<<currentTab>> $mode=block/>
\end

<$list filter="[all[current]multitag[Person,Player,Organisation,Deity,Location,Artifact,Item,Material,Creature,Spell]] [all[current]tag[Quest]] [all[current]!is[tiddler]questmarked[]] :filter[trpg.visible[]]" variable=null>
<$reveal tag="div" class="tc-tiddler-body" type="nomatch" stateTitle=<<folded-state>> text="hide" retain="yes" animate="yes">
<$let currentNode=<<currentTiddler>> self=<<currentTiddler>>
	trpg-kinds={{{ [trpg.egonodes<currentTiddler>relationkind[]] +[format:titlelist[]join[ ]] }}}
	trpg-state={{{ [<currentTiddler>addprefix[$:/state/tiddlyrpg-core/relations-filter/]] }}}>
<%if [<currentTiddler>tag[Quest]] [<currentTiddler>!is[tiddler]questmarked[]] +[first[]] %>
<$transclude $tiddler="$:/plugins/flibbles/graph/ui/grouped-tabs"
	tabsList="[[$:/plugins/tiddlyrpg-core/viewtemplates/relations/quest-graph]] [[$:/plugins/tiddlyrpg-core/viewtemplates/relations/quest-list]]"
	default="$:/plugins/tiddlyrpg-core/viewtemplates/relations/quest-graph"
	explicitState={{{ [<currentTiddler>addprefix[$:/state/tiddlyrpg-core/quest-relations-tab/]] }}}
	class="">
<$fill $name=body><<trpg.relationstab>></$fill>
</$transclude>
<%else%>
<$transclude $tiddler="$:/plugins/flibbles/graph/ui/grouped-tabs"
	tabsList="[[$:/plugins/tiddlyrpg-core/viewtemplates/relations/graph]] [[$:/plugins/tiddlyrpg-core/viewtemplates/relations/list]]"
	default="$:/plugins/tiddlyrpg-core/viewtemplates/relations/graph"
	explicitState={{{ [<currentTiddler>addprefix[$:/state/tiddlyrpg-core/relations-tab/]] }}}
	class="">
<$fill $name=body><<trpg.relationstab>></$fill>
</$transclude>
<%endif%>
</$let>
</$reveal>
</$list>

title: $:/plugins/tiddlyrpg-core/viewtemplates/fields
type: text/vnd.tiddlywiki

\whitespace trim
<!-- The block of values below the image, before the body - laid out
     like the stat block of a rulebook (filters/fields.js, modules/fields.js): the header line in
     italics, then the sections parted by a line - the fields of no group with the price, then
     the groups: "list" a line "Label value" each, "row" a small table (label above the value),
     "inline" the lines in one line, parted by a dot. The relations a group names follow as
     pills. Every value as text. A price or value that cannot be read is a message below the
     title (checks/items.js, checks/fields.js). Nothing without a value to show; not for a
     tiddler the view does not see. The colour of the rules and labels is the colour of the type
     (--trpg-type). -->
\procedure trpg.fieldline(field)
<span class="trpg-fields-line"><span class="trpg-fields-label"><$text text={{{ [<currentTiddler>trpgfieldlabel<field>] }}}/></span><$text text=" "/><$text text={{{ [<currentTiddler>trpgfieldshow<field>] }}}/></span>
\end

<$reveal tag="div" class="tc-tiddler-body" type="nomatch" stateTitle=<<folded-state>> text="hide" retain="yes" animate="yes">
<%if [<currentTiddler>trpg.visible[]] %>
<$let trpg-summary={{{ [<currentTiddler>trpgfieldsummary[]] }}}>
<%if [<trpg-summary>!is[blank]] [<currentTiddler>trpgfieldsections[]] +[limit[1]] %>
<div class="trpg-fields" style={{{ [<currentTiddler>trpgfieldcolor[]addprefix[--trpg-type:]] }}}>
<%if [<trpg-summary>!is[blank]] %>
<div class="trpg-fields-summary"><$text text=<<trpg-summary>>/></div>
<%endif%>
<$list filter="[<currentTiddler>trpgfieldsections[]]" variable="trpg-section">
<$let trpg-layout={{{ [<currentTiddler>trpgfieldsection:layout<trpg-section>] }}}>
<div class={{{ [[trpg-fields-section trpg-fields-]addsuffix<trpg-layout>] }}}>
<%if [<trpg-layout>match[row]] %>
<$list filter="[<currentTiddler>trpgfieldlines<trpg-section>]" variable="trpg-field">
<div class="trpg-fields-cell"><span class="trpg-fields-label"><$text text={{{ [<currentTiddler>trpgfieldlabel<trpg-field>] }}}/></span><$text text={{{ [<currentTiddler>trpgfieldshow<trpg-field>] }}}/></div>
</$list>
<%elseif [<trpg-layout>match[inline]] %>
<div class="trpg-fields-lines"><$list filter="[<currentTiddler>trpgfieldlines<trpg-section>]" variable="trpg-field" join=" · "><$transclude $variable="trpg.fieldline" field=<<trpg-field>>/></$list></div>
<%else%>
<$list filter="[<currentTiddler>trpgfieldlines<trpg-section>]" variable="trpg-field">
<div class="trpg-fields-lines"><$transclude $variable="trpg.fieldline" field=<<trpg-field>>/></div>
</$list>
<%endif%>
<$list filter="[<currentTiddler>trpgfieldsection:relations<trpg-section>]" variable="trpg-relation">
<div class="trpg-fields-lines"><span class="trpg-fields-label"><$text text={{{ [<trpg-relation>addprefix[Field/]trpgtranslate[]] }}}/></span><$text text=" "/><$list filter="[<currentTiddler>get<trpg-relation>enlist-input[]] :filter[trpg.visible[]]" variable="trpg-target"><$transclude $variable="trpg.pill" title=<<trpg-target>>/></$list></div>
</$list>
</div>
</$let>
</$list>
</div>
<%endif%>
</$let>
<%endif%>
</$reveal>

title: $:/plugins/tiddlyrpg-core/viewtemplates/event-list/tabs
type: text/vnd.tiddlywiki

<!-- Tab list "Timeline"/"List" for events, like "Graph"/"List" for relations. The caller sets
     the variable trpg-events (filter of the event tiddlers); both tabs use it and leave out events
     the active view does not see (trpg.visible) - not even title and date are shown. A tab state
     per tiddler ($:/state/tiddlyrpg-core/events-tab/<title>): a tiddler opened the first time
     shows the timeline. -->
<$transclude $tiddler="$:/plugins/flibbles/graph/ui/grouped-tabs"
	tabsList="[[$:/plugins/tiddlyrpg-core/viewtemplates/event-list/timeline]] [[$:/plugins/tiddlyrpg-core/viewtemplates/event-list/list]]"
	default="$:/plugins/tiddlyrpg-core/viewtemplates/event-list/timeline"
	explicitState={{{ [<currentTiddler>addprefix[$:/state/tiddlyrpg-core/events-tab/]] }}}
	class="">
<$fill $name=body>
<$transclude $tiddler=<<currentTab>> $mode=block/>
</$fill>
</$transclude>

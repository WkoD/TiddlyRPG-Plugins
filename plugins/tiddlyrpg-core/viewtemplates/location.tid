title: $:/plugins/tiddlyrpg-core/viewtemplates/location
type: text/vnd.tiddlywiki

<!-- Maps of every location, as tabs: "Map" - the first map with the graph of the location
     (viewtemplates/location/map, also without a map image or anything on it) -, every further
     map (filter maptabs, labelled with the file name), and "Quests and rumours" (the open quests
     that lead here and why, viewtemplates/location/quests). The tab state is one tiddler per
     location ($:/state/tiddlyrpg-core/location-tab/<title>), ids "map", "map-<n>", "quests".
     Below the maps the spots with their images and texts, from the parse tree of the body
     (trpg-body, widgets/sections.js): the procedure spot draws heading, jump mark
     "spot-<name>" and images, a locked spot shows only to a view that sees it. A rule above parts
     them from the relations, like the rules around the event list. -->
\function trpg.maplabel() [<currentTiddler>maptabs[]] :filter[jsonget[id]match<currentTab>] +[first[]jsonget[label]]

<$list filter="[all[current]tag[Location]]" variable=null>
<%if [<currentTiddler>trpg.visible[]] %>
<$reveal tag="div" class="tc-tiddler-body" type="nomatch" stateTitle=<<folded-state>> text="hide" retain="yes" animate="yes">
<hr>
<$let trpg-tabs={{{ [<currentTiddler>maptabs[]jsonget[id]] ~[[map]] [[quests]] +[format:titlelist[]join[ ]] }}}>
<$transclude $tiddler="$:/plugins/flibbles/graph/ui/grouped-tabs"
	tabsList=<<trpg-tabs>>
	default="map"
	explicitState={{{ [<currentTiddler>addprefix[$:/state/tiddlyrpg-core/location-tab/]] }}}
	class="">
<$fill $name=button><$text text={{{ [<currentTab>match[map]then[Map/Tab]trpgtranslate[]] ~[<currentTab>match[quests]then[Relations/Kind/Quest]trpgtranslate[]] ~[trpg.maplabel[]] }}}/></$fill>
<$fill $name=body>
<%if [<currentTab>match[map]] %>
<$transclude $tiddler="$:/plugins/tiddlyrpg-core/viewtemplates/location/map" $mode=block/>
<%elseif [<currentTab>match[quests]] %>
<$transclude $tiddler="$:/plugins/tiddlyrpg-core/viewtemplates/location/quests" $mode=block/>
<%else%>
<$list filter="[<currentTiddler>maptabs[]] :filter[jsonget[id]match<currentTab>] +[first[]]" variable="trpg-entry"><$transclude $variable="trpg.image" entry=<<trpg-entry>>/></$list>
<%endif%>
</$fill>
</$transclude>
</$let>
<div class="trpg-spots">
<$trpg-body $tiddler=<<currentTiddler>> $mode="block" $only="spot"/>
</div>
</$reveal>
<%endif%>
</$list>

title: $:/plugins/tiddlyrpg-core/viewtemplates/location
type: text/vnd.tiddlywiki

<!-- Maps of a location as tabs: "Map" if it has a map image (field map), spots or places within
     (with or without a map image), then one tab per battle map (field battlemap of the location, then per spot; filter maptabs). Default
     tab = the first one. The tab state is one tiddler per location
     ($:/state/tiddlyrpg-core/location-tab/<title>), so a jump (widgets/jump.js) can select the
     map tab before it scrolls to a spot. Tab ids: "map", "battlemap[-<n>]",
     "battlemap-<spot>[-<n>]". A rule above the tabs parts them from the relations, like the
     rules around the event list. -->
\function trpg.tablabel() [<currentTiddler>maptabs[]] :filter[jsonget[id]match<currentTab>] +[first[]jsonget[label]]

<$list filter="[all[current]tag[Location]]" variable=null>
<%if [<currentTiddler>trpg.visible[]] %>
<$let trpg-tabs={{{ [<currentTiddler>has[map]] [<currentTiddler>spots[]] [<currentTiddler>sublocations[]] +[first[]then[map]] [<currentTiddler>maptabs[]jsonget[id]] +[format:titlelist[]join[ ]] }}}>
<%if [<trpg-tabs>!is[blank]] %>
<$reveal tag="div" class="tc-tiddler-body" type="nomatch" stateTitle=<<folded-state>> text="hide" retain="yes" animate="yes">
<hr>
<$transclude $tiddler="$:/plugins/flibbles/graph/ui/grouped-tabs"
	tabsList=<<trpg-tabs>>
	default={{{ [enlist<trpg-tabs>first[]] }}}
	explicitState={{{ [<currentTiddler>addprefix[$:/state/tiddlyrpg-core/location-tab/]] }}}
	class="">
<$fill $name=button><$text text={{{ [<currentTab>match[map]then[Title/Map]trpgtranslate[]] ~[trpg.tablabel[]] }}}/></$fill>
<$fill $name=body>
<%if [<currentTab>match[map]] %>
<$transclude $tiddler="$:/plugins/tiddlyrpg-core/viewtemplates/location/map" $mode=block/>
<%else%>
<$transclude $tiddler="$:/plugins/tiddlyrpg-core/viewtemplates/location/battlemap" $mode=block/>
<%endif%>
</$fill>
</$transclude>
</$reveal>
<%endif%>
</$let>
<%endif%>
</$list>

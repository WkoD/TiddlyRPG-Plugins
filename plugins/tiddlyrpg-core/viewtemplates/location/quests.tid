title: $:/plugins/tiddlyrpg-core/viewtemplates/location/quests
type: text/vnd.tiddlywiki

<!-- The tab "Quests and rumours" of a location (viewtemplates/location): the open quests and
     rumours the map shows (trpg.mapquests), by name, each with its label (procedure quest) and,
     below it, why it leads here (questroutes, modules/quests.js), one row each: what its newest
     marker links - a location, someone or something as a pill (trpg.pill), a spot as the pill of
     a spot (trpg.spotpill: "Spot (Location)", it jumps to the spot on the map of the location
     that has it) - and, if that is not itself where it leads, "→" and the place of the map it
     leads to. The location of a spot: the node of the route up to "#" if it has the spot, else
     the first place below that node that has it. Rows 4px apart, quests 11px (styles/location). -->
\whitespace trim

<$let trpg-loc=<<currentTiddler>>>
<div class="trpg-map-quests">
<$list filter="[trpg.mapquests<trpg-loc>sort[]]" variable="trpg-quest" emptyMessage="""<div class="trpg-quest-empty"><$text text={{{ [[Map/Quests/Empty]trpgtranslate[]] }}}/></div>""">
<div class="trpg-map-quest">
<$transclude $variable="quest" name=<<trpg-quest>>/>
<$list filter="[<trpg-quest>questroutes<trpg-loc>]" variable="trpg-route">
<$let trpg-via={{{ [<trpg-route>jsonget[via]] }}}
	trpg-how={{{ [<trpg-route>jsonget[how]] }}}
	trpg-node={{{ [<trpg-route>jsonget[node]] }}}>
<div class="trpg-map-quest-route">
<%if [<trpg-how>match[spot]] %>
<$let trpg-place={{{ [<trpg-node>split[#]first[]] }}}
	trpg-owner={{{ [<trpg-place>] [<trpg-place>sublocations:all[]] :filter[spots[]match<trpg-via>] +[first[]] ~[<trpg-place>] }}}>
<$transclude $variable="trpg.spotpill" place=<<trpg-owner>> spot=<<trpg-via>>/>
</$let>
<%else%>
<$transclude $variable="trpg.pill" title=<<trpg-via>>/>
<%endif%>
<%if [<trpg-how>!match[spot]] :filter[<trpg-node>!match<trpg-via>!match<trpg-loc>] %>
<span class="trpg-via"><$text text="→"/></span><$transclude $variable="trpg.pill" title=<<trpg-node>>/>
<%endif%>
</div>
</$let>
</$list>
</div>
</$list>
</div>
</$let>

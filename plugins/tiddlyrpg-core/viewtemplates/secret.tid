<!-- Marker of a locked tiddler (tag Secret) below the tags, for everyone who sees it (the DM
     and the players it is for): who it is for, or "DM only". -->
<$reveal tag="div" class="tc-tiddler-body" type="nomatch" stateTitle=<<folded-state>> text="hide" retain="yes" animate="yes">
<%if [<currentTiddler>tag[Secret]] :filter[trpg.visible[]] %>
<$let trpg-for={{{ [<currentTiddler>trpgcharacters[]] +[join[, ]] }}}>
<div class="trpg-secret-marker">{{$:/core/images/locked-padlock}}<$text text={{{ [<trpg-for>!is[blank]] :then[[Secret/For]trpgtranslate[]search-replace[$names$],<trpg-for>] ~[[Secret/DMOnly]trpgtranslate[]] }}}/></div>
</$let>
<%endif%>
</$reveal>

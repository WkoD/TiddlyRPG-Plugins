<!-- Marker of a locked tiddler (tag Secret) as a bar above the title, for everyone who sees it
     (the DM and the players it is for): who it is for, or "DM only". The frame around the
     tiddler: config/class-secret, styles/sections. -->
<%if [<currentTiddler>tag[Secret]] :filter[trpg.visible[]] %>
<$let trpg-for={{{ [<currentTiddler>trpgcharacters[]] +[join[, ]] }}}>
<div class="trpg-secret-marker trpg-secret-head">{{$:/core/images/locked-padlock}}<$text text={{{ [<trpg-for>!is[blank]] :then[[Secret/For]trpgtranslate[]search-replace[$names$],<trpg-for>] ~[[Secret/DMOnly]trpgtranslate[]] }}}/></div>
</$let>
<%endif%>

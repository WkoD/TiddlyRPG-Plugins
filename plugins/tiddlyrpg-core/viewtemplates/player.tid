<!-- The real player of a figure (field player): the player of an active character (tag Player)
     or of a figure someone played before. -->
<$reveal tag="div" class="tc-tiddler-body" type="nomatch" stateTitle=<<folded-state>> text="hide" retain="yes" animate="yes">
<%if [<currentTiddler>trpg.visible[]] %>
<$list filter="[all[current]has[player]!is[system]]">
<b><<trpg.t Player/Player>></b> {{!!player}}
</$list>
<%endif%>
</$reveal>

<!-- The price of an item (field price), as written with the unit labels of the display language
     of the currency (modules/currency.js, priceformat); a plain number without currency. A price
     that cannot be read gets a hint below the title (itemcheck). Not for a tiddler the view does
     not see. -->
<$reveal tag="div" class="tc-tiddler-body" type="nomatch" stateTitle=<<folded-state>> text="hide" retain="yes" animate="yes">
<%if [<currentTiddler>trpg.visible[]] %>
<$list filter="[all[current]has:field[price]]">
<b><<trpg.t Item/Price>></b> <$text text={{{ [{!!price}priceformat[]] }}}/>
<br>
</$list>
<%endif%>
</$reveal>

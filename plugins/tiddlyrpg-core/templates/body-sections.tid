title: $:/plugins/tiddlyrpg-core/templates/body-sections
type: text/vnd.tiddlywiki

<!-- Body of a tiddler with sections (modules/sections.js): rendered by trpg-body
     (widgets/sections.js), which leaves out what the active view does not see. A location shows
     its spots in the tab "Map" (viewtemplates/location/map), not here. Chosen by
     viewtemplates/body-filter-sections (cascade $:/tags/ViewTemplateBodyFilter, after the lock
     of the whole tiddler). -->
<$trpg-body $tiddler=<<currentTiddler>> $mode="block" $omit={{{ [<currentTiddler>tag[Location]then[spot]] }}}>

<$transclude tiddler="$:/language/MissingTiddler/Hint"/>

</$trpg-body>

title: $:/plugins/tiddlyrpg-core/templates/subtitle
type: text/vnd.tiddlywiki

\whitespace trim
<!-- Subtitle of every tiddler like the core default ($:/core/ui/ViewTemplate/subtitle/default),
     but without the modifier: in these wikis it is always the same person, and git keeps the
     history. The modified date stays (also a hint for the players). -->
<$reveal type="nomatch" stateTitle=<<folded-state>> text="hide" tag="div" retain="yes" animate="yes">
<div class="tc-subtitle tc-clearfix">
<$list filter="[all[shadows+tiddlers]tag[$:/tags/ViewTemplate/Subtitle]!has[draft.of]] -[[$:/core/ui/ViewTemplate/subtitle/modifier]]" variable="subtitleTiddler">
<$transclude tiddler=<<subtitleTiddler>> mode="inline"/>
</$list>
</div>
</$reveal>

title: Player
type: text/vnd.tiddlywiki

\whitespace trim
<!-- The player characters as cards with portrait (the first image of the field image, without
     tabs), name, the lines of the ruleset ("card" of the schema of Player, filters/fields.js
     trpgfieldcard: "Level 13", derived from the XP), a line per entry without parent of each
     tree (trpgcardtrees: folk, classes - "Dragonborn · Draconic Ancestry: Black", "Fighter 5 ·
     Battle Master" with the level of the class; an entry the view does not see takes its branch
     along, and the levels) and player: the active ones (tag
     Player), below them those someone played before (any other tiddler with a field player).
     Which view the wiki shows is chosen in the page controls (ui/view-switcher). The hub Campaign
     sets trpg-player-heading to "no": it shows the first heading itself, beside the list of the
     hubs. -->
\procedure trpg.playercard()
\whitespace trim
<$link to=<<currentTiddler>> class={{{ [<currentTiddler>trpg.dead[]then[trpg-player-card trpg-dead]else[trpg-player-card]] }}}>
<span class="trpg-player-portrait"><$list filter="[<currentTiddler>imagetabs[]first[]jsonget[path]]" variable="trpg-path"><$image source=<<trpg-path>>/></$list></span>
<span class="trpg-player-name"><$text text={{{ [<currentTiddler>get[caption]else<currentTiddler>] }}}/></span>
<$list filter="[<currentTiddler>trpgfieldcard[]]" variable="trpg-line"><span class="trpg-player-line"><$text text=<<trpg-line>>/></span></$list>
<$list filter="[<currentTiddler>trpgcardtrees[]]" variable="trpg-line"><span class="trpg-player-line"><$text text=<<trpg-line>>/></span></$list>
<span class="trpg-player-of"><$text text={{{ [<currentTiddler>get[player]] }}}/></span>
</$link>
\end

<%if [<trpg-player-heading>!match[no]] %><h3><$text text={{{ [[Player/Active]trpgtranslate[]] }}}/></h3><%endif%>
<div class="trpg-players">
<$list filter="[tag[Player]!is[draft]] :filter[trpg.visible[]] +[sort[title]]"><<trpg.playercard>></$list>
</div>
<$list filter="[!is[system]!is[draft]!tag[Player]has[player]] :filter[trpg.visible[]] +[sort[title]] +[limit[1]]" variable="ignore">
<h3><$text text={{{ [[Player/Former]trpgtranslate[]] }}}/></h3>
<div class="trpg-players">
<$list filter="[!is[system]!is[draft]!tag[Player]has[player]] :filter[trpg.visible[]] +[sort[title]]"><<trpg.playercard>></$list>
</div>
</$list>

caption: <<trpg.t Settings/Rules/Caption>>
condition: [trpgrulesdomains[]] [{$:/config/tiddlyrpg/calendar}!is[blank]]
created: 20261009190000000
list-after: $:/plugins/tiddlyrpg-core/ui/settings-ruleset
modified: 20261009190000000
tags: $:/tags/tiddlyrpg/SettingsTab
title: $:/plugins/tiddlyrpg-core/ui/settings-rules
type: text/vnd.tiddlywiki

<!-- Tab of ControlPanel -> Settings -> TiddlyRPG: the rules language (modules/language.js) - the
     settings "written in" (input) and "shown in" (display), each with its mode; below a table
     of the registered domains: the language each one follows, selectable in the mode "per
     domain", and an example. Only languages with keys are offered (trpgruleslangs). Shows only
     with a registered domain or an own calendar (field condition). -->
\procedure trpg.langname(code)
<$text text={{{ [<code>addprefix[$:/languages/]get[description]else<code>] }}}/>
\end

\procedure trpg.langselect(tiddler,domain)
\whitespace trim
<$select tiddler=<<tiddler>> default="" disabled=<<trpg-disabled>>>
<option value=""><<trpg.t Settings/Rules/WikiLanguage>></option>
<$list filter="[trpgruleslangs<domain>]" variable="trpg-code">
<option value=<<trpg-code>>><$transclude $variable="trpg.langname" code=<<trpg-code>>/></option>
</$list>
</$select>
\end

\procedure trpg.rulesset(set)
<$let trpg-base={{{ [<set>addprefix[$:/config/tiddlyrpg/rules/]] }}}
	trpg-mode={{{ [<trpg-base>addsuffix[/mode]] }}}>
<div class="trpg-rules-set">

''<$text text={{{ [<set>addprefix[Settings/Rules/Set/]trpgtranslate[]] }}}/>''

<$radio tiddler=<<trpg-mode>> value="wiki" default="wiki" disabled=<<trpg-disabled>>> <<trpg.t Rules/Mode/wiki>></$radio><br>
<$radio tiddler=<<trpg-mode>> value="all" default="wiki" disabled=<<trpg-disabled>>> <<trpg.t Rules/Mode/all>></$radio>&#32;<$transclude $variable="trpg.langselect" tiddler={{{ [<trpg-base>addsuffix[/language]] }}}/><br>
<$radio tiddler=<<trpg-mode>> value="domain" default="wiki" disabled=<<trpg-disabled>>> <<trpg.t Rules/Mode/domain>></$radio>
</div>
</$let>
\end

\procedure trpg.rulescell(set,domain)
\whitespace trim
<%if [<set>match[input]] :filter[<domain>trpgrulesdomain[kinds]match[no]] %>
—
<%elseif [<set>addprefix[$:/config/tiddlyrpg/rules/]addsuffix[/mode]get[text]match[domain]] %>
<$transclude $variable="trpg.langselect" tiddler={{{ [<set>addprefix[$:/config/tiddlyrpg/rules/]addsuffix[/domain/]addsuffix<domain>] }}} domain=<<domain>>/>
<%else%>
<$transclude $variable="trpg.langname" code={{{ [<set>match[input]] :then[trpgruleslang:input<domain>] ~[trpgruleslang:display<domain>] }}}/>
<%endif%>
\end

<$let trpg-disabled={{{ [{$:/status/IsReadOnly}match[yes]then[yes]else[no]] }}}>

<<trpg.t Settings/Rules/Hint>>

<<trpg.rulesset input>>

<<trpg.rulesset display>>

<table class="trpg-rules-table">
<tr><th><<trpg.t Settings/Rules/Domain>></th><th><<trpg.t Settings/Rules/Set/input>></th><th><<trpg.t Settings/Rules/Set/display>></th><th><<trpg.t Settings/Rules/Example>></th></tr>
<$list filter="[trpgrulesdomains[]]" variable="trpg-domain">
<tr>
<td><$text text={{{ [<trpg-domain>addprefix[Rules/Domain/]trpgtranslate[]removeprefix[Rules/Domain/]] ~[<trpg-domain>addprefix[Rules/Domain/]trpgtranslate[]] }}}/></td>
<td><$transclude $variable="trpg.rulescell" set="input" domain=<<trpg-domain>>/></td>
<td><$transclude $variable="trpg.rulescell" set="display" domain=<<trpg-domain>>/></td>
<td><$text text={{{ [<trpg-domain>trpgrulesexample[]else[—]] }}}/></td>
</tr>
</$list>
</table>
</$let>

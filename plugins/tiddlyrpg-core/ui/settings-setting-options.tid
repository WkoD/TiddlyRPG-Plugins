modified: 20261011175213295
tags: $:/tags/tiddlyrpg/SettingsTab
title: $:/plugins/tiddlyrpg-core/ui/settings-setting-options
type: text/vnd.tiddlywiki

<!-- Tab of ControlPanel -> Settings -> TiddlyRPG: the settings of the campaign setting - the
     rules language of its domains (ui/settings-rules, group setting: calendar and currency names)
     and, with a calendar, the order of day and month in dates ($:/config/tiddlyrpg/date/order,
     modules/dates.js: as the wiki language says, "dm" or "md") with an example; with a campaign
     setting a link to the hub CampaignSetting on top. Shows while a campaign setting is active,
     and with an own calendar or currency of the wiki. -->
\import [[$:/plugins/tiddlyrpg-core/ui/settings-rules]]
<$let trpg-disabled={{{ [{$:/status/IsReadOnly}match[yes]then[yes]else[no]] }}}>

<<trpg.t Settings/SettingOptions/Hint>>
<%if [trpgplugin[setting]] %>

<<trpg.t Settings/SettingOptions/Hub>> <$link to="CampaignSetting"><$text text={{{ [[CampaignSetting]trpgtitle[]] }}}/></$link>
<%endif%>

!! <<trpg.t Settings/Rules/Caption>>

<$transclude $variable="trpg.ruleslanguage" group="setting"/>

<%if [{$:/config/tiddlyrpg/calendar}!is[blank]] %>

!! <<trpg.t Settings/Dates/Caption>>

<<trpg.t Settings/Dates/Hint>>

''<<trpg.t Settings/Dates/Order>>''

<$radio tiddler="$:/config/tiddlyrpg/date/order" value="" default="" disabled=<<trpg-disabled>>> <<trpg.t Settings/Dates/Order/wiki>></$radio><br>
<$radio tiddler="$:/config/tiddlyrpg/date/order" value="dm" default="" disabled=<<trpg-disabled>>> <<trpg.t Settings/Dates/Order/dm>></$radio><br>
<$radio tiddler="$:/config/tiddlyrpg/date/order" value="md" default="" disabled=<<trpg-disabled>>> <<trpg.t Settings/Dates/Order/md>></$radio>

<<trpg.t Settings/Dates/Example>> <<dateformat "1351-01-05">> · <<dateformat "1351-01-05/1351-01-24">> · <<dateformat "1351-01-05/1351-03-24">>
<%endif%>
</$let>

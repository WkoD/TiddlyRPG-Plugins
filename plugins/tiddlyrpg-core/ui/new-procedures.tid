<!-- "+" in the toolbar of the hub of a type (ui/hub-new), a button like the others of the toolbar
     (tv-config-toolbar-class, icon and text as the toolbar shows them): a new draft with the type
     tag and nothing else - the form in the editor shows the fields the type expects (editor/form).
     An event asks for its date first (ui/new-event) and starts with the field date and <<date>> at
     the start of the text. Items (the hub Item) and a category of several base types
     (modules/categories.js, never alone, categories/base) offer the base types as a plain list; a
     category of one base type takes it at once (Folk: Folk Information). Only in the editable
     wiki. -->
\procedure trpg.newbutton(type)
\whitespace trim
<$let trpg-popup=<<qualify "$:/state/popup/tiddlyrpg/new">>
	trpg-hint={{{ [[New/Hub]trpgtranslate[]addsuffix[ ]] [<type>trpgtitle[]] +[join[]] }}}
	trpg-kind={{{ [<type>trpgcategorybases[]first[]then<type>] }}}
	trpg-bases={{{ [<type>match[Item]then[Artifact Item Material]] ~[<type>trpgcategorybases[]format:titlelist[]join[ ]] }}}
	trpg-class={{{ [<tv-config-toolbar-class>] [[trpg-hub-plus]] +[join[ ]] }}}>
<%if [<type>match[Event]] [enlist<trpg-bases>count[]compare:number:gt[1]] +[limit[1]] %>
<span class="tc-popup-keep">
<$button popup=<<trpg-popup>> class=<<trpg-class>> tooltip=<<trpg-hint>> aria-label=<<trpg-hint>> selectedClass="tc-selected">
<%if [<tv-config-toolbar-icons>match[yes]] %>
{{$:/core/images/new-button}}
<%endif%>
<%if [<tv-config-toolbar-text>match[yes]] %>
<span class="tc-btn-text"><$text text=<<trpg-hint>>/></span>
<%endif%>
</$button>
</span>
<$reveal state=<<trpg-popup>> type="popup" position="belowleft" animate="yes">
<div class="tc-drop-down tc-popup-keep">
<%if [<type>match[Event]] %>
<div class="trpg-editor-dropdown">
<div class="trpg-editor-head"><$text text=<<trpg-hint>>/></div>
<$let trpg-input=<<qualify "$:/temp/tiddlyrpg-core/new-event">>>
<$transclude $tiddler="$:/plugins/tiddlyrpg-core/ui/new-event"/>
</$let>
</div>
<%else%>
<$list filter="[enlist<trpg-bases>]" variable="trpg-base">
<$button class="tc-btn-invisible">
<$action-sendmessage $message="tm-new-tiddler" tags={{{ [<trpg-kind>!is[blank]] [<trpg-base>] +[format:titlelist[]join[ ]] }}}/>
<$action-deletetiddler $tiddler=<<trpg-popup>>/>
<$text text={{{ [<trpg-base>trpgtitle[]] }}}/>
</$button>
</$list>
<%endif%>
</div>
</$reveal>
<%else%>
<$button class=<<trpg-class>> tooltip=<<trpg-hint>> aria-label=<<trpg-hint>>>
<$action-sendmessage $message="tm-new-tiddler" tags={{{ [<type>] [enlist<trpg-bases>] +[format:titlelist[]join[ ]] }}}/>
<%if [<tv-config-toolbar-icons>match[yes]] %>
{{$:/core/images/new-button}}
<%endif%>
<%if [<tv-config-toolbar-text>match[yes]] %>
<span class="tc-btn-text"><$text text=<<trpg-hint>>/></span>
<%endif%>
</$button>
<%endif%>
</$let>
\end

<!-- Read after the date input (ui/new-event; focus) -->
\procedure trpg.neweventbutton()
\whitespace trim
<$let trpg-date={{{ [<trpg-input>get[text]trim[]] }}}
	trpg-out={{{ [<trpg-date>dateformat[]] }}}>
<%if [<trpg-date>!is[blank]] %>
<div class={{{ [<trpg-date>datecheck[]then[trpg-editor-reading trpg-editor-bad]else[trpg-editor-reading]] }}}><$text text={{{ [<trpg-date>datecheck[]then[Editor/Date/Bad]trpgtranslate[]] ~[[Editor/Output]trpgtranslate[]addsuffix[ ]addsuffix<trpg-out>] }}}/></div>
<%endif%>
<div class="trpg-editor-actions">
<$button class="trpg-do" disabled={{{ [<trpg-date>is[blank]then[yes]else[no]] }}}>
<$action-sendmessage $message="tm-new-tiddler" tags="Event" date=<<trpg-date>> text="""<<date>>

"""/>
<$action-deletetiddler $tiddler=<<trpg-input>>/>
<$action-deletetiddler $filter="[prefix[$:/state/popup/tiddlyrpg/new]]"/>
<$text text={{{ [[New/Create]trpgtranslate[]] }}}/>
</$button>
</div>
</$let>
\end

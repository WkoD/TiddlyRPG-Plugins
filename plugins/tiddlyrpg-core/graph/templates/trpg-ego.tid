caption: TiddlyRPG ego graph (1 hop, type colours)
created: 20260708125907000
modified: 20261022161612307
title: $:/plugins/tiddlyrpg-core/graph/templates/trpg-ego

\whitespace trim

\procedure trpg.node()
<$wikify name=label mode=inline text={{{ [{!!title}get[caption]else[<$text text={{!!title}} />]] }}}>
<$node label=<<label>> image={{!!icon}} />
</$wikify>
\end trpg.node

<!-- Ego network around <<currentNode>>: centre + 1-hop neighbours (entities + items).
     No persistence, physics on. Colours from the type tags, drawn like pills (trpgPill); the
     dead/dissolved striped grey and that colour (trpgDead, graph/pill.js) as the innermost level. Automatic edges tags/list/links/transcludes hidden. Edge labels are
     translated by the override of $edges.typed.
     A location as centre (filters/location.js): its spots that are locations ("Teil von") count
     as the centre too, with their neighbours. All places within it (every depth, both kinds)
     are nodes too, with their edges among each other, without their own neighbours (who is
     there: the tree of the list). Other locations are left out; the parent is in the path below
     the title.
     The open quests that mention the centre (questsabout): a node each, gold for a quest, silver
     for a rumour, with an edge to what it mentions among the nodes (questmentions) and to the
     quests linked with it (questlinks). Only the kinds switched on above the block
     (trpg.egoshown, viewtemplates/relations); the centre always. -->


<$graph>
<$properties $for=graph $tiddler="$:/config/tiddlyrpg/graph/physics" />
<$properties $for=nodes actions="<$action-navigate $to=<<nodeTiddler>> />">
<$properties physics=yes shape=box trpgPill="yes">

<$properties $filter="[tag[Event]]"      color={{Event!!color}}>
<$properties $filter="[tag[Deity]]"           color={{Deity!!color}}>
<$properties $filter="[tag[Location]]"            color={{Location!!color}}>
<$properties $filter="[tag[Artifact]] [tag[Item]] [tag[Material]]" color={{Item!!color}}>
<$properties $filter="[tag[Person]]"         color={{Person!!color}}>
<$properties $filter="[tag[Player]]"        color={{Player!!color}}>
<$properties $filter="[tag[Organisation]]"   color={{Organisation!!color}}>
<$properties $filter="[tag[Creature]]"   color={{Creature!!color}}>
<$properties $filter="[tag[Spell]]"   color={{Spell!!color}}>
<$properties $filter="[tag[Person]trpg.dead[]]" trpgDead="yes">
<$properties $filter="[tag[Player]trpg.dead[]]" trpgDead="yes">
<$properties $filter="[tag[Organisation]trpg.dead[]]" trpgDead="yes">
<$properties $filter="[tag[Creature]trpg.dead[]]" trpgDead="yes">
<$properties $filter="[tag[Artifact]] [tag[Item]] [tag[Material]] +[trpg.dead[]]" trpgDead="yes">

<$let trpg-centre={{{ [<currentNode>] [<currentNode>tag[Location]sublocations:all[spot]] :filter[trpg.visible[]] +[format:titlelist[]join[ ]] }}}>

<$list filter="[enlist<trpg-centre>]">
<<trpg.node>>
<$edges.typed $fields="[all[]] -[[tags]] -[[list]]" $functions="[all[]] -[[links]] -[[transcludes]]" />
</$list>

<%if [<currentNode>tag[Location]] %>
<$list filter="[<currentNode>sublocations:all[]] -[enlist<trpg-centre>] :filter[trpg.visible[]] :filter[trpg.egoshown<currentNode>]">
<<trpg.node>>
<$edges.typed $fields="location" $functions="spots" />
</$list>
<$nodes.neighbors
  $filter="[enlist<trpg-centre>]"
  $fields="[all[]] -[[tags]] -[[list]]"
  $functions="[all[]] -[[links]] -[[transcludes]]"
  $whitelist="[!is[system]!is[draft]] -[tag[Location]] :filter[trpg.visible[]] :filter[trpg.egoshown<currentNode>]"
  $interedges="yes" />
<%else%>
<$nodes.neighbors
  $filter="[<currentNode>]"
  $fields="[all[]] -[[tags]] -[[list]]"
  $functions="[all[]] -[[links]] -[[transcludes]]"
  $whitelist="[!is[system]!is[draft]] :filter[trpg.visible[]] :filter[trpg.egoshown<currentNode>]"
  $interedges="yes" />
<%endif%>

<$list filter="[enlist<trpg-centre>questsabout[]] :filter[trpg.egoshown<currentNode>]">
<$node label=<<currentTiddler>> color={{{ [<currentTiddler>questreal[]then{Quest!!color}else[#9aa1aa]] }}} />
<$list filter="[<currentTiddler>questmentions[]]" variable="toTiddler"><$edge $to=<<toTiddler>> color={{Quest!!color}} /></$list>
<$list filter="[<currentTiddler>questlinks[]] :filter[compare:string:gt<..currentTiddler>]" variable="toTiddler"><$edge $to=<<toTiddler>> color={{Quest!!color}} /></$list>
</$list>

</$let>

</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$graph>

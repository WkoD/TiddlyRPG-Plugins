caption: TiddlyRPG graph (type colours, no saved positions)
created: 20260708125907000
modified: 20261007163804094
title: $:/plugins/tiddlyrpg-core/graph/templates/trpg-graph

\whitespace trim

\procedure trpg.node()
<$wikify name=label mode=inline text={{{ [{!!title}get[caption]else[<$text text={{!!title}} />]] }}}>
<$node label=<<label>> image={{!!icon}} />
</$wikify>
\end trpg.node

<!-- Like live-graph: no $properties.persistent -> no positions are saved.
     Node colour comes from the colour of the type tag ({{Person!!color}} etc.); grey
     (dead/dissolved, trpg.dead) as the innermost, highest priority. No per-node !!color -> the tag
     colour rules uniformly, changing it recolours all nodes of the type.
     Edge labels are translated (Field/<field>) by the override of $edges.typed in tiddlyrpg-core. -->

<$set name="focusTiddler" filter="[subfilter{!!filter}]">
<$graph>
<$properties $for=graph $tiddler="$:/config/tiddlyrpg/graph/physics" />
<$properties $for=nodes actions="<$action-navigate $to=<<nodeTiddler>> />">
<$properties.settings>
<$properties physics=yes shape=box>

<$slot $name=ts-raw $depth=5 />

<$properties $filter="[tag[Event]]"      color={{Event!!color}}>
<$properties $filter="[tag[Deity]]"           color={{Deity!!color}}>
<$properties $filter="[tag[Location]]"            color={{Location!!color}}>
<$properties $filter="[tag[Artifact]] [tag[Item]] [tag[Material]]" color={{Item!!color}}>
<$properties $filter="[tag[Person]]"         color={{Person!!color}}>
<$properties $filter="[tag[Player]]"        color={{Player!!color}}>
<$properties $filter="[tag[Organisation]]"   color={{Organisation!!color}}>
<$properties $filter="[tag[Person]trpg.dead[]]"       color="#dddddd" borderColor={{Person!!color}}>
<$properties $filter="[tag[Player]trpg.dead[]]"      color="#dddddd" borderColor={{Player!!color}}>
<$properties $filter="[tag[Organisation]trpg.dead[]]" color="#dddddd" borderColor={{Organisation!!color}}>
<$properties $filter="[tag[Artifact]] [tag[Item]] [tag[Material]] +[trpg.dead[]]" color="#dddddd" borderColor={{Item!!color}}>

<$list filter="[subfilter{!!filter}] :filter[trpg.visible[]]">
<<trpg.node>>
<$edges.typed />
</$list>

</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties>
</$properties.settings>
</$properties>
</$graph>
</$set>

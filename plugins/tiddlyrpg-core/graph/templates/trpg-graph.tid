caption: TiddlyRPG graph (type colours, no saved positions)
created: 20260708125907000
modified: 20261103173828774
title: $:/plugins/tiddlyrpg-core/graph/templates/trpg-graph

\whitespace trim

\procedure trpg.node()
<$wikify name=label mode=inline text={{{ [{!!title}get[caption]else[<$text text={{!!title}} />]] }}}>
<$node label=<<label>> image={{!!icon}} />
</$wikify>
\end trpg.node

<!-- Like live-graph: no $properties.persistent -> no positions are saved.
     Node colour comes from the colour of the type tag ({{Person!!color}} etc.), drawn like a pill
     (trpgPill); the dead/dissolved (trpg.dead) striped grey and that colour (trpgDead,
     graph/pill.js) as the innermost, highest priority. No per-node !!color -> the tag
     colour rules uniformly, changing it recolours all nodes of the type.
     Edge labels are translated (Field/<field>) by the override of $edges.typed in tiddlyrpg-core.
     Above the graph the switches by kind (trpg.kindswitches, functions.tid) of what it shows, like
     the ego graph; the kinds switched off are in the field list of
     $:/state/tiddlyrpg-core/graph-filter/<graph> (not saved), a node shows when its kind is on
     (trpg.kindshown). -->

<$let trpg-graph-state={{{ [<currentTiddler>addprefix[$:/state/tiddlyrpg-core/graph-filter/]] }}}
	trpg-graph-titles={{{ [subfilter{!!filter}] :filter[trpg.visible[]] +[format:titlelist[]join[ ]] }}}
	trpg-graph-kinds={{{ [enlist<trpg-graph-titles>relationkind[]] +[unique[]] +[format:titlelist[]join[ ]] }}}>
<$transclude $variable="trpg.kindswitches" kinds=<<trpg-graph-kinds>> state=<<trpg-graph-state>> titles=<<trpg-graph-titles>>/>
<$set name="focusTiddler" filter="[subfilter{!!filter}]">
<$graph>
<$properties $for=graph $tiddler="$:/config/tiddlyrpg/graph/physics" />
<$properties $for=nodes actions="<$action-navigate $to=<<nodeTiddler>> />">
<$properties.settings>
<$properties physics=yes shape=box trpgPill="yes">

<$slot $name=ts-raw $depth=5 />

<$transclude $variable="trpg.graphnodes">

<$list filter="[subfilter{!!filter}] :filter[trpg.visible[]] :filter[trpg.kindshown<trpg-graph-state>]">
<<trpg.node>>
<$edges.typed />
</$list>

</$transclude>
</$properties>
</$properties.settings>
</$properties>
</$graph>
</$set>
</$let>

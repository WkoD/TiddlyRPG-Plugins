<!-- The shortcuts of the data (shortcut in the domains): <<wis save>> is <<term wis save>>,
     <<ft 30 range>> is <<unit "30 ft" range>> -->
\procedure str(variant) <$transclude $variable="term" id="str" arg=<<variant>>/>
\procedure wis(variant) <$transclude $variable="term" id="wis" arg=<<variant>>/>
\procedure ac(variant) <$transclude $variable="term" id="ac" arg=<<variant>>/>
\procedure dc(variant) <$transclude $variable="term" id="dc" arg=<<variant>>/>
\procedure xp(variant) <$transclude $variable="term" id="xp" arg=<<variant>>/>
\procedure ft(n,kind) <$transclude $variable="unit" value={{{ [<n>addsuffix[ ft]] }}} kind=<<kind>>/>
\procedure mi(n,kind) <$transclude $variable="unit" value={{{ [<n>addsuffix[ mi]] }}} kind=<<kind>>/>
\procedure lb(n,kind) <$transclude $variable="unit" value={{{ [<n>addsuffix[ lb]] }}} kind=<<kind>>/>

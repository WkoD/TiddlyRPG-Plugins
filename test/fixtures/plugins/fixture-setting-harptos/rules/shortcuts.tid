<!-- The shortcuts of the coins: <<gp 50>> is <<unit "50 gp">>. sp has a shortcut in the data but
     no procedure here, so the tests see one struck through. -->
\procedure cp(n) <$transclude $variable="unit" value={{{ [<n>addsuffix[ cp]] }}}/>
\procedure gp(n) <$transclude $variable="unit" value={{{ [<n>addsuffix[ gp]] }}}/>
